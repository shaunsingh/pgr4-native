+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2021 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ *
+ * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
+ */
+
+#include "vfs_dump_command.h"
+
+#include <filesystem>
+#include <memory>
+#include <queue>
+#include <span>
+#include <string>
+#include <vector>
+
+#include <CLI/CLI.hpp>
+#include <fmt/format.h>
+
+#include <rex/filesystem.h>
+#include <rex/filesystem/devices/stfs_container_device.h>
+#include <rex/filesystem/file.h>
+#include <rex/logging.h>
+
+namespace rexglue::cli {
+
+namespace {
+
+struct VfsDumpArgs {
+  std::string source;
+  std::string dump_path;
+};
+
+// xenia-vfs-dump: writes every file of the STFS package at source below dump_path.
+rex::Result<void> VfsDump(const std::filesystem::path& source,
+                          const std::filesystem::path& base_path) {
+  using namespace rex::filesystem;
+  using rex::X_STATUS;
+  auto device = std::make_unique<StfsContainerDevice>("", source);
+  if (!device->Initialize()) {
+    return rex::Err<void>(rex::ErrorCategory::Format,
+                          fmt::format("{}: not an STFS package", rex::path_to_utf8(source)));
+  }
+
+  // Run through all the files, breadth-first style.
+  std::queue<Entry*> queue;
+  queue.push(device->ResolvePath(""));
+  std::vector<uint8_t> buffer;
+  while (!queue.empty()) {
+    auto* entry = queue.front();
+    queue.pop();
+    for (auto& child : entry->children()) {
+      queue.push(child.get());
+    }
+
+    auto dest_name = base_path / rex::to_path(entry->path());
+    if (entry->attributes() & kFileAttributeDirectory) {
+      std::error_code ec;
+      std::filesystem::create_directories(dest_name, ec);
+      if (ec) {
+        return rex::Err<void>(rex::ErrorCategory::IO,
+                              fmt::format("{}: {}", rex::path_to_utf8(dest_name), ec.message()));
+      }
+      continue;
+    }
+
+    File* in_file = nullptr;
+    if (entry->Open(FileAccess::kFileReadData, &in_file) != X_STATUS_SUCCESS) {
+      return rex::Err<void>(
+          rex::ErrorCategory::IO,
+          fmt::format("{}: cannot open {}", rex::path_to_utf8(source), entry->path()));
+    }
+    buffer.resize(entry->size());
+    size_t bytes_read = 0;
+    in_file->ReadSync(std::span<uint8_t>(buffer), 0, &bytes_read);
+    in_file->Destroy();
+
+    auto* file = rex::filesystem::OpenFile(dest_name, "wb");
+    const bool written = file && fwrite(buffer.data(), 1, bytes_read, file) == bytes_read &&
+                         bytes_read == buffer.size();
+    if (file) {
+      fclose(file);
+    }
+    if (!written) {
+      return rex::Err<void>(rex::ErrorCategory::IO,
+                            fmt::format("{}: cannot write it", rex::path_to_utf8(dest_name)));
+    }
+    REXLOG_INFO("{}", entry->path());
+  }
+  return rex::Ok();
+}
+
+}  // namespace
+
+void RegisterVfsDump(CLI::App& parent, const CliContext& ctx, DeferredAction& pending) {
+  (void)ctx;
+  auto args = std::make_shared<VfsDumpArgs>();
+  auto* sub =
+      parent.add_subcommand("vfs-dump", "Extract the files of an STFS package")->fallthrough();
+  sub->add_option("source", args->source, "The package")->type_name("PATH")->required();
+  sub->add_option("dump_path", args->dump_path, "The folder to extract it to")
+      ->type_name("PATH")
+      ->required();
+  sub->callback([args, &pending]() {
+    pending = [args]() {
+      return VfsDump(rex::to_path(args->source), rex::to_path(args->dump_path));
+    };
+  });
+}
+
+}  // namespace rexglue::cli
