                                    system::KernelState* kernel_state)
     : memory_(graphics_system->memory()),
@@ -693,6 +992,11 @@ void CommandProcessor::ExecuteIndirectBuffer(uint32_t ptr, uint32_t count) {
   // Execute commands!
   memory::RingBuffer reader(memory_->TranslatePhysical(ptr), count * sizeof(uint32_t));
   reader.set_write_offset(count * sizeof(uint32_t));
+  const bool stream_stats_enabled = stream_stats::Enabled();
+  if (stream_stats_enabled) {
+    stream_stats::OnIndirectBufferBegin(memory_->TranslatePhysical(ptr), ptr, count,
+                                        uint32_t(stream_stats::Get().stack.size()) + 1);
+  }
   do {
     if (!ExecutePacket(&reader)) {
       // Return up a level if we encounter a bad packet.
@@ -701,6 +1005,9 @@ void CommandProcessor::ExecuteIndirectBuffer(uint32_t ptr, uint32_t count) {
       break;
     }
   } while (reader.read_count());
+  if (stream_stats_enabled) {
+    stream_stats::OnIndirectBufferEnd();
+  }
 }
 
