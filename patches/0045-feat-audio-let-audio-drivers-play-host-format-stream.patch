+bool SDLAudioDriver::InitializeHostFormat() {
+  // A frame boundary must fall on a sample boundary, since SDL only accepts
+  // whole sample frames.
+  if (!frame_frequency_ || !frame_channels_ || frame_channels_ > kHostChannelsMax ||
+      kFrameSamplesMax % frame_channels_) {
+    REXAPU_ERROR("SDLAudioDriver: unsupported host stream of {} ch at {} Hz", frame_channels_,
+                 frame_frequency_);
+    return false;
+  }
+
+  // The stream side keeps the source rate and layout; SDL resamples and remaps
+  // to the endpoint on its own thread.
+  SDL_AudioSpec spec = {};
+  spec.freq = static_cast<int>(frame_frequency_);
+  spec.format = SDL_AUDIO_F32;
+  spec.channels = static_cast<int>(frame_channels_);
+  sdl_device_channels_ = static_cast<uint8_t>(frame_channels_);
+  sdl_stream_ =
+      SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, SDLCallback, this);
+  if (!sdl_stream_) {
+    REXAPU_ERROR("SDL_OpenAudioDeviceStream() failed for host stream: {}", SDL_GetError());
+    return false;
+  }
+
+  applied_gain_ = 1.0f;
+  REXAPU_INFO("audio host stream: {} ch, {} Hz, {} samples per frame", frame_channels_,
+              frame_frequency_, channel_samples_);
+
+  if (!SDL_ResumeAudioStreamDevice(sdl_stream_)) {
+    REXAPU_ERROR("SDL_ResumeAudioStreamDevice() failed: {}", SDL_GetError());
+    return false;
+  }
+  return true;
+}
+
+void SDLAudioDriver::SubmitFrame(float* frame) {
   float* output_frame;
   {
     std::unique_lock<std::mutex> guard(frames_mutex_);
+    // The pool only grows until it covers the semaphore's frame budget.
     if (frames_unused_.empty()) {
