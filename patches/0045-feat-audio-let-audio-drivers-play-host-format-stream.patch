+void SDLAudioDriver::PutHostFrames(SDL_AudioStream* stream, int additional_amount) {
+  // The stream applies the gain when the device pulls, so a volume change
+  // reaches what is already queued and the frames need no copy here.
+  const float gain = REXCVAR_GET(audio_mute)
+                         ? 0.0f
+                         : volume_.load(std::memory_order_relaxed) * GetOutputGain();
+  if (gain != applied_gain_ && SDL_SetAudioStreamGain(stream, gain)) {
+    applied_gain_ = gain;
+  }
+
+  std::unique_lock<std::mutex> guard(frames_mutex_);
+  // An empty queue is left short: the device thread pads it with silence, and
+  // queueing silence here would only delay the next real frame.
+  while (additional_amount > 0 && !frames_queued_.empty()) {
+    auto buffer = frames_queued_.front();
+    frames_queued_.pop();
+    const bool put = SDL_PutAudioStreamData(stream, buffer, static_cast<int>(frame_size_));
+    frames_unused_.push(buffer);
+    // A dropped frame still returns its slot, or the producer would wait on it
+    // forever.
+    auto ret = semaphore_->Release(1, nullptr);
+    assert_true(ret);
+    if (!put) {
+      REXAPU_ERROR("SDL_PutAudioStreamData() failed: {}", SDL_GetError());
+      break;
+    }
+    additional_amount -= static_cast<int>(frame_size_);
+  }
+}
