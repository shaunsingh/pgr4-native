From 19f90c90f6b2955bd21fcff150095bbb4d4a3d6d Mon Sep 17 00:00:00 2001
From: shaurizard <contact@nyoom.engineering>
Date: Sat, 24 Oct 2026 12:11:13 -0400
Subject: [PATCH 10/32] gpu: take shader constant writes off the
 special-register path

Shader constant writes are by far the most frequent register writes
(float, bool/loop and fetch constants, sent in runs by PM4 type-0
packets and SET_CONSTANT), and each went through the generic path:

- CommandProcessor::WriteRegister looked the register up in
  RegisterFile::GetRegisterInfo, a large switch, only to log a debug
  message for unknown registers, then checked it against the scratch,
  COHER and gamma ramp registers. Constants are none of those: return
  after the volatile store, and look the register up only when the GPU
  log category is at debug level.
- ExecutePacketType0 wrote a sequential run one register at a time.
  Send it through WriteRegisterRangeFromRing, which the D3D12 backend
  turns into one byte-swapping copy and one binding check per constant
  block, as Xenia Canary does (src/xenia/gpu/
  pm4_command_processor_implement.h, ExecutePacketType0). Runs that are
  not entirely inside one constant block still go register by register.
- The D3D12 backend invalidated constant buffers, texture bindings and
  vertex buffer residency on every constant write, also when the value
  did not change. Titles resend whole constant groups unchanged (from
  MTR-PGR4's patched SDK, which carries these early-outs for Project
  Gotham Racing 4). A write or a range write that leaves every value as
  it was now returns before invalidating anything. What else a binding
  depends on is tracked separately: texture contents by their memory
  watches (texture_became_outdated_), and IssueDraw requests a vertex
  buffer again only when its address or size differs from the last
  request (vertex_buffer_states_), which an unchanged fetch constant
  cannot cause.

Co-authored-by: factory-droid[bot] <138933559+factory-droid[bot]@users.noreply.github.com>
---
 src/graphics/command_processor.cpp       | 25 +++++++++++++++----
 src/graphics/d3d12/command_processor.cpp | 31 ++++++++++++++++++++++++
 2 files changed, 51 insertions(+), 5 deletions(-)

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index a744375..1de3657 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -355,7 +355,18 @@ void CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
 
   // Volatile for the WAIT_REG_MEM loop.
   const_cast<volatile uint32_t&>(regs.values[index]) = value;
-  if (!regs.GetRegisterInfo(index)) {
+  // Shader constants, the most frequent writes by far, are plain storage with no side effects
+  // here; the backend tracks their bindings.
+  if ((index >= XE_GPU_REG_SHADER_CONSTANT_000_X && index <= XE_GPU_REG_SHADER_CONSTANT_511_W) ||
+      (index >= XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031 &&
+       index <= XE_GPU_REG_SHADER_CONSTANT_LOOP_31) ||
+      (index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
+       index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5)) {
+    return;
+  }
+  // GetRegisterInfo is a large switch, looked up only for this debug message.
+  auto* gpu_logger = rex::GetLoggerRaw(rex::log::gpu());
+  if (gpu_logger && gpu_logger->should_log(spdlog::level::debug) && !regs.GetRegisterInfo(index)) {
     REXGPU_DEBUG("GPU: Write to unknown register ({:04X} = {:08X})", index, value);
   }
 
@@ -702,10 +713,14 @@ bool CommandProcessor::ExecutePacketType0(memory::RingBuffer* reader, uint32_t p
 
   uint32_t base_index = (packet & 0x7FFF);
   uint32_t write_one_reg = (packet >> 15) & 0x1;
-  for (uint32_t m = 0; m < count; m++) {
-    uint32_t reg_data = reader->ReadAndSwap<uint32_t>();
-    uint32_t target_index = write_one_reg ? base_index : base_index + m;
-    WriteRegister(target_index, reg_data);
+  if (write_one_reg) {
+    for (uint32_t m = 0; m < count; m++) {
+      WriteRegister(base_index, reader->ReadAndSwap<uint32_t>());
+    }
+  } else {
+    // A sequential write goes through the range writer, which the backend can handle as one copy
+    // (most of these packets set runs of shader constants).
+    WriteRegisterRangeFromRing(reader, base_index, count);
   }
 
   return true;
diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 19874a5..3c443c2 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -1769,6 +1769,16 @@ void D3D12CommandProcessor::ShutdownContext() {
 }
 
 void D3D12CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
+  // Rewriting a shader constant with its current value changes no binding: keep the constant
+  // buffers, texture bindings and vertex buffer residency that depend on it.
+  if (((index >= XE_GPU_REG_SHADER_CONSTANT_000_X && index <= XE_GPU_REG_SHADER_CONSTANT_511_W) ||
+       (index >= XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031 &&
+        index <= XE_GPU_REG_SHADER_CONSTANT_LOOP_31) ||
+       (index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
+        index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5)) &&
+      register_file_->values[index] == value) {
+    return;
+  }
   CommandProcessor::WriteRegister(index, value);
 
   if (index >= XE_GPU_REG_SHADER_CONSTANT_000_X && index <= XE_GPU_REG_SHADER_CONSTANT_511_W) {
@@ -1808,6 +1818,18 @@ void D3D12CommandProcessor::WriteRegistersFromMem(uint32_t start_index, uint32_t
   }
   uint32_t end_index = start_index + num_registers - 1;
 
+  // Titles often send whole constant groups again unchanged; the copy and the binding
+  // invalidation are skipped for those.
+  auto range_unchanged = [&]() {
+    const uint32_t* old_values = register_file_->values + start_index;
+    for (uint32_t i = 0; i < num_registers; ++i) {
+      if (old_values[i] != memory::load_and_swap<uint32_t>(base + i)) {
+        return false;
+      }
+    }
+    return true;
+  };
+
   auto range_has_any_constant_usage = [](const uint64_t* usage_map, uint32_t first_constant,
                                          uint32_t last_constant) -> bool {
     if (first_constant > last_constant) {
@@ -1836,6 +1858,9 @@ void D3D12CommandProcessor::WriteRegistersFromMem(uint32_t start_index, uint32_t
 
   if (start_index >= XE_GPU_REG_SHADER_CONSTANT_000_X &&
       end_index <= XE_GPU_REG_SHADER_CONSTANT_511_W) {
+    if (range_unchanged()) {
+      return;
+    }
     memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
     if (frame_open_) {
       uint32_t first_float_constant = (start_index - XE_GPU_REG_SHADER_CONSTANT_000_X) >> 2;
@@ -1862,6 +1887,9 @@ void D3D12CommandProcessor::WriteRegistersFromMem(uint32_t start_index, uint32_t
 
   if (start_index >= XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031 &&
       end_index <= XE_GPU_REG_SHADER_CONSTANT_LOOP_31) {
+    if (range_unchanged()) {
+      return;
+    }
     memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
     cbuffer_binding_bool_loop_.up_to_date = false;
     return;
@@ -1869,6 +1897,9 @@ void D3D12CommandProcessor::WriteRegistersFromMem(uint32_t start_index, uint32_t
 
   if (start_index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
       end_index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5) {
+    if (range_unchanged()) {
+      return;
+    }
     memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
     cbuffer_binding_fetch_.up_to_date = false;
     uint32_t first_fetch_dword = start_index - XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0;
-- 
