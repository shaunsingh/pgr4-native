 namespace rex::system {
 
+namespace {
+
+// Mounts the title update installed for title_id as update:, as Xenia Canary's
+// KernelState::FindTitleUpdate and LoadTitleUpdate do. It stays mounted: the title reads its
+// data files there too.
+bool OpenTitleUpdate(KernelState* kernel_state, uint32_t title_id) {
+  auto* content = kernel_state->content_manager();
+  const auto updates = content->ListContent(1, 0, XContentType::kInstaller, title_id);
+  uint32_t license = 0;
+  return !updates.empty() &&
+         content->OpenContent("UPDATE", 0, updates.front(), license) == X_ERROR_SUCCESS;
+}
+
+}  // namespace
