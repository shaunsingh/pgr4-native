diff --git a/src/graphics/util/precise_sleep.cpp b/src/graphics/util/precise_sleep.cpp
new file mode 100644
index 0000000..23ae286
--- /dev/null
+++ b/src/graphics/util/precise_sleep.cpp
@@ -0,0 +1,75 @@
+/**
+ * @file        graphics/util/precise_sleep.cpp
+ * @brief       Sleeps shorter than the system timer period for the GPU threads
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "precise_sleep.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <thread>
+
+#if REX_PLATFORM_WIN32
+#include <windows.h>
+#endif
+
+namespace rex::graphics {
+
+#if REX_PLATFORM_WIN32
+
+namespace {
+using NtDelayExecutionFn = LONG(WINAPI*)(BOOLEAN alertable, const LARGE_INTEGER* timeout);
+}  // namespace
+
+PreciseSleep::PreciseSleep() {
+  // Under Wine a waitable timer is a wineserver object: arming it is a request to the server and
+  // its expiry a wakeup from it. Wine runs NtDelayExecution in the process instead, as a poll
+  // with a microsecond timeout. On Windows NtDelayExecution is rounded up to the timer period,
+  // so Windows gets a high-resolution waitable timer.
+  HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+  if (ntdll && GetProcAddress(ntdll, "wine_get_version")) {
+    delay_execution_ = reinterpret_cast<void*>(GetProcAddress(ntdll, "NtDelayExecution"));
+  }
+  if (!delay_execution_) {
+    timer_ = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                    TIMER_ALL_ACCESS);
+  }
+}
+
+PreciseSleep::~PreciseSleep() {
+  if (timer_) {
+    CloseHandle(timer_);
+  }
+}
+
+bool PreciseSleep::SleepFor(std::chrono::nanoseconds duration) {
+  LARGE_INTEGER due_time;
+  // Negative: relative to now, in 100 ns units.
+  due_time.QuadPart = -std::max<int64_t>(1, duration.count() / 100);
+  if (delay_execution_) {
+    return reinterpret_cast<NtDelayExecutionFn>(delay_execution_)(FALSE, &due_time) >= 0;
+  }
+  if (!timer_) {
+    return false;
+  }
+  return SetWaitableTimer(timer_, &due_time, 0, nullptr, nullptr, FALSE) &&
+         WaitForSingleObject(timer_, INFINITE) == WAIT_OBJECT_0;
+}
+
+#else
+
+PreciseSleep::PreciseSleep() = default;
+
+PreciseSleep::~PreciseSleep() = default;
+
+bool PreciseSleep::SleepFor(std::chrono::nanoseconds duration) {
+  std::this_thread::sleep_for(duration);
+  return true;
+}
+
+#endif
+
+}  // namespace rex::graphics
diff --git a/src/graphics/util/precise_sleep.h b/src/graphics/util/precise_sleep.h
new file mode 100644
index 0000000..b64e7cc
--- /dev/null
+++ b/src/graphics/util/precise_sleep.h
@@ -0,0 +1,39 @@
+/**
+ * @file        graphics/util/precise_sleep.h
+ * @brief       Sleeps shorter than the system timer period for the GPU threads
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <chrono>
+
+#include <rex/platform.h>
+
+namespace rex::graphics {
+
+// A sleep that is not rounded up to the system timer period, for the GPU threads that poll for
+// guest progress or wait for a deadline. Owned and used by one thread.
+class PreciseSleep {
+ public:
+  PreciseSleep();
+  ~PreciseSleep();
+  PreciseSleep(const PreciseSleep&) = delete;
+  PreciseSleep& operator=(const PreciseSleep&) = delete;
+
+  // Returns false without sleeping if no precise sleep is available, so that the caller can
+  // fall back to its ordinary sleep.
+  bool SleepFor(std::chrono::nanoseconds duration);
+
+ private:
+#if REX_PLATFORM_WIN32
+  // NtDelayExecution, found only under Wine.
+  void* delay_execution_ = nullptr;
+  // A high-resolution waitable timer, used otherwise.
+  void* timer_ = nullptr;
+#endif
+};
+
+}  // namespace rex::graphics
