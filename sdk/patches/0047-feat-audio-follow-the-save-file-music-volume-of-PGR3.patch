new file mode 100644
index 0000000..94f77b4
--- /dev/null
+++ b/src/system/util/xmp_volume_patch.cpp
@@ -0,0 +1,143 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ *
+ * @modified    2026 - Ported to the ReXGlue runtime from Xenia Canary 451f915
+ */
+
+#include <rex/system/util/xmp_volume_patch.h>
+
+#include <rex/audio/audio_media_player.h>
+#include <rex/audio/audio_system.h>
+#include <rex/logging.h>
+#include <rex/runtime.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/xmemory.h>
+
+namespace rex::system::util {
+
+namespace {
+
+// Convert a volume byte to a float in [0.0001, 1.0]. Uses a near-zero floor
+// instead of 0.0f so the audio player doesn't interpret it as "never set"
+// and override with the default volume.
+float ByteToVolume(uint8_t value, uint8_t max_value) {
+  if (value == 0) {
+    return 0.0001f;
+  }
+  return static_cast<float>(value) / static_cast<float>(max_value);
+}
+
+}  // namespace
+
+bool XmpVolumePatch::Matches(const std::string& name, uint32_t length) const {
+  if (name.find(config_.file_name) == std::string::npos) {
+    return false;
+  }
+  if (config_.write_length != 0) {
+    return length == config_.write_length;
+  }
+  return length >= config_.offset + 1;
+}
+
+void XmpVolumePatch::SetPlayerVolume(float volume) {
+  auto* audio_system = static_cast<audio::AudioSystem*>(kernel_state_->emulator()->audio_system());
+  if (auto* player = audio_system ? audio_system->media_player() : nullptr) {
+    player->SetVolume(volume);
+  }
+}
+
+void XmpVolumePatch::ApplyVolume(const uint8_t* buffer, [[maybe_unused]] uint32_t length) {
+  uint8_t volume_byte = buffer[config_.offset];
+  if (volume_byte > config_.max_value) {
+    return;
+  }
+
+  float volume = ByteToVolume(volume_byte, config_.max_value);
+
+  REXSYS_DEBUG("XmpVolumePatch: volume={}/{} -> {:.2f}", volume_byte, config_.max_value, volume);
+
+  last_volume_ = volume_byte;
+  SetPlayerVolume(volume);
+}
+
+void XmpVolumePatch::PollGuestVolume() {
+  const uint32_t settings_addr = settings_guest_addr_.load(std::memory_order_relaxed);
+  if (!settings_addr) {
+    return;
+  }
+
+  auto* mem = kernel_state_->memory();
+  uint32_t vol_addr = settings_addr + config_.offset;
+  // The read buffer is the title's; stop following it once it is unmapped.
+  auto* heap = mem->LookupHeap(vol_addr);
+  uint32_t protect = 0;
+  if (!heap || !heap->QueryProtect(vol_addr, &protect) ||
+      !(protect & memory::kMemoryProtectRead)) {
+    settings_guest_addr_.store(0, std::memory_order_relaxed);
+    return;
+  }
+  uint8_t current = mem->TranslateVirtual<uint8_t*>(vol_addr)[0];
+
+  if (current == last_volume_ || current > config_.max_value) {
+    return;
+  }
+
+  last_volume_ = current;
+  float volume = ByteToVolume(current, config_.max_value);
+
+  REXSYS_DEBUG("XmpVolumePatch: polled volume change={}/{} -> {:.2f}", current, config_.max_value,
+               volume);
+
+  SetPlayerVolume(volume);
+}
+
+void XmpVolumePatch::OnFileWrite(const std::string& name, const uint8_t* buffer, uint32_t length,
+                                 [[maybe_unused]] uint32_t guest_address) {
+  if (Matches(name, length)) {
+    ApplyVolume(buffer, length);
+  }
+}
+
+void XmpVolumePatch::OnFileRead(const std::string& name, const uint8_t* buffer, uint32_t length,
+                                uint32_t guest_address) {
+  if (Matches(name, length)) {
+    settings_guest_addr_.store(guest_address, std::memory_order_relaxed);
+    ApplyVolume(buffer, length);
+  }
+}
+
+void XmpVolumePatch::OnInputPoll(uint32_t packet_number) {
+  if (last_packet_number_.exchange(packet_number, std::memory_order_relaxed) == packet_number) {
+    return;
+  }
+  PollGuestVolume();
+}
+
+std::unique_ptr<XmpVolumePatch> XmpVolumePatch::CreateForTitle(uint32_t title_id,
+                                                               KernelState* ks) {
+  XmpVolumeConfig config;
+
+  switch (title_id) {
+    case 0x544307D2:  // DOAX2
+      config = {"ups.dat", 0, 0x50, 100};
+      break;
+    case 0x4D5307D1:  // PGR3
+      config = {"profile.save", 528, 19, 10};
+      break;
+    case 0x4D5307F9:  // PGR4
+      config = {"savegame", 344, 2, 10};
+      break;
+    default:
+      return nullptr;
+  }
+
+  REXSYS_INFO("XmpVolumePatch: Loading for title {:08X}", title_id);
+  return std::make_unique<XmpVolumePatch>(ks, config);
+}
+
+}  // namespace rex::system::util
