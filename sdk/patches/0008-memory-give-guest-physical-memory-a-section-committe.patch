+// Where guest physical memory starts in map_info's target addresses. It has a section of its
+// own, physical_mapping_, which is committed when it is created: the heaps never decommit it,
+// and on a section that commits on demand every protection change on a view costs a wineserver
+// round trip under Wine (5-7 times the cost of the call otherwise), which the GPU's write
+// watches on physical memory make thousands of times a second.
+constexpr uint64_t kPhysicalTargetBase = 0x100000000ull;
+
 bool Memory::Initialize() {
-  file_name_ = fmt::format("xenia_memory_{}", chrono::Clock::QueryHostTickCount());
+  const uint64_t tick = chrono::Clock::QueryHostTickCount();
+  file_name_ = fmt::format("xenia_memory_{}", tick);
+  physical_file_name_ = fmt::format("xenia_memory_{}_physical", tick);
 
-  // Create main page file-backed mapping. This is all reserved but
-  // uncommitted (so it shouldn't expand page file).
-  // Round up to allocation granularity to accommodate platforms with large pages.
-  const size_t mapping_size =
-      rex::round_up(static_cast<size_t>(0x120000000ull) + system_allocation_granularity_,
-                    static_cast<size_t>(system_allocation_granularity_));
-  mapping_ = rex::memory::CreateFileMappingHandle(file_name_, mapping_size,
+  // Guest virtual memory: page file-backed, reserved but uncommitted (so it shouldn't expand
+  // the page file). The heaps commit it on demand.
+  mapping_ = rex::memory::CreateFileMappingHandle(file_name_, kPhysicalTargetBase,
                                                   rex::memory::PageAccess::kReadWrite, false);
   if (mapping_ == rex::memory::kFileMappingHandleInvalid) {
     REXSYS_ERROR("Unable to reserve the 4gb guest address space.");
@@ -148,6 +157,20 @@ bool Memory::Initialize() {
     return false;
   }
 
+  // Guest physical memory, committed up front so the GPU can access it without page faults
+  // (reference: xenia-canary 5f5be0668). Rounded up to the allocation granularity for the
+  // 0xE0000000 view's 4 KB offset on platforms with large pages.
+  const size_t physical_mapping_size =
+      rex::round_up(static_cast<size_t>(0x20000000) + system_allocation_granularity_,
+                    static_cast<size_t>(system_allocation_granularity_));
+  physical_mapping_ = rex::memory::CreateFileMappingHandle(
+      physical_file_name_, physical_mapping_size, rex::memory::PageAccess::kReadWrite, true);
+  if (physical_mapping_ == rex::memory::kFileMappingHandleInvalid) {
+    REXSYS_ERROR("Unable to commit the 512mb guest physical memory.");
+    assert_always();
+    return false;
+  }
