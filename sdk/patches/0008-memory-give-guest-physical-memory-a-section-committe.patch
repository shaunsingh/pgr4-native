     void* target_address = mapping_base + map_info[n].virtual_address_start;
     void* result = mmap(target_address, view_size, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED,
-                        mapping_, file_offset);
+                        mapping, file_offset);
     if (result == MAP_FAILED || result != target_address) {
       int err = errno;
       REXSYS_ERROR(
@@ -358,16 +376,36 @@ int Memory::MapViewsMac() {
 }
 #endif  // REX_PLATFORM_MAC
 
+std::pair<rex::memory::FileMappingHandle, uint64_t> Memory::ViewSource(size_t n) const {
+  const uint64_t target = map_info[n].target_address;
+  if (target >= kPhysicalTargetBase) {
+    return {physical_mapping_, target - kPhysicalTargetBase};
+  }
+  return {mapping_, target};
+}
+
+// Whether the view holding a guest virtual address maps guest physical memory.
+static bool MapsPhysicalMemory(uint32_t virtual_address) {
+  for (const auto& view : map_info) {
+    if (virtual_address >= view.virtual_address_start &&
+        virtual_address <= view.virtual_address_end) {
+      return view.target_address >= kPhysicalTargetBase;
+    }
+  }
+  return false;
+}
+
 int Memory::MapViews(uint8_t* mapping_base) {
   assert_true(rex::countof(map_info) == rex::countof(views_.all_views));
   // 0xE0000000 4 KB offset is emulated via host_address_offset and on the CPU
   // side if system allocation granularity is bigger than 4 KB.
   uint64_t granularity_mask = ~uint64_t(system_allocation_granularity_ - 1);
   for (size_t n = 0; n < rex::countof(map_info); n++) {
+    const auto [mapping, offset] = ViewSource(n);
     views_.all_views[n] = reinterpret_cast<uint8_t*>(rex::memory::MapFileView(
-        mapping_, mapping_base + map_info[n].virtual_address_start,
+        mapping, mapping_base + map_info[n].virtual_address_start,
         map_info[n].virtual_address_end - map_info[n].virtual_address_start + 1,
-        rex::memory::PageAccess::kReadWrite, map_info[n].target_address & granularity_mask));
+        rex::memory::PageAccess::kReadWrite, offset & granularity_mask));
     if (!views_.all_views[n]) {
       // Failed, so bail and try again.
       UnmapViews();
@@ -381,7 +419,7 @@ void Memory::UnmapViews() {
   for (size_t n = 0; n < rex::countof(views_.all_views); n++) {
     if (views_.all_views[n]) {
       size_t length = map_info[n].virtual_address_end - map_info[n].virtual_address_start + 1;
-      rex::memory::UnmapFileView(mapping_, views_.all_views[n], length);
+      rex::memory::UnmapFileView(ViewSource(n).first, views_.all_views[n], length);
     }
   }
 }
@@ -516,8 +554,14 @@ bool Memory::AddVirtualMappedRange(uint32_t virtual_address, uint32_t mask, uint
       reinterpret_cast<uintptr_t>(range_start) & ~(uintptr_t(host_page_size) - 1));
   const size_t aligned_length =
       rex::round_up(size_t(range_start - aligned_start) + size, host_page_size);
-  if (!rex::memory::AllocFixed(aligned_start, aligned_length, rex::memory::AllocationType::kCommit,
-                               rex::memory::PageAccess::kNoAccess)) {
+  // Guest physical memory, which holds the windows at 0x7F000000, is committed already.
+  const bool mapped =
+      MapsPhysicalMemory(virtual_address)
+          ? rex::memory::Protect(aligned_start, aligned_length, rex::memory::PageAccess::kNoAccess)
+          : rex::memory::AllocFixed(aligned_start, aligned_length,
+                                    rex::memory::AllocationType::kCommit,
+                                    rex::memory::PageAccess::kNoAccess) != nullptr;
+  if (!mapped) {
     REXSYS_ERROR("Unable to map range; commit/protect failed");
     return false;
   }
@@ -1056,6 +1100,15 @@ void BaseHeap::Dispose() {
   }
 }
 
+bool BaseHeap::AllocHostPages(void* host_address, size_t length, rex::memory::AllocationType type,
+                              rex::memory::PageAccess access) {
+  if (heap_type_ != memory::HeapType::kGuestPhysical) {
+    return rex::memory::AllocFixed(host_address, length, type, access) != nullptr;
+  }
+  return type == rex::memory::AllocationType::kReserve ||
+         rex::memory::Protect(host_address, length, access, nullptr);
+}
