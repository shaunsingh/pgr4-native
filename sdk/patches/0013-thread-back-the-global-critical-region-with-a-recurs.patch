diff --git a/include/rex/thread/mutex.h b/include/rex/thread/mutex.h
index 6e5755a..f885616 100644
--- a/include/rex/thread/mutex.h
+++ b/include/rex/thread/mutex.h
@@ -11,10 +11,37 @@
 
 #pragma once
 
+#include <atomic>
+#include <cstdint>
 #include <mutex>
 
 namespace rex::thread {
 
+#if defined(_WIN32)
+// A recursive lock over an SRW lock, as Xenia uses for its global mutex on Windows.
+class alignas(64) global_mutex_type {
+ public:
+  global_mutex_type() = default;
+  global_mutex_type(const global_mutex_type&) = delete;
+  global_mutex_type& operator=(const global_mutex_type&) = delete;
+
+  void lock();
+  void unlock();
+  bool try_lock();
+
+ private:
+  // An SRWLOCK, kept as its single pointer-sized field so this header needs no windows.h.
+  void* srwlock_ = nullptr;
+  // Only the owner stores its own id here, so another thread can never read its own id
+  // unless it holds the lock.
+  std::atomic<uint32_t> owner_thread_{0};
+  uint32_t recursion_count_ = 0;
+};
+#else
+using global_mutex_type = std::recursive_mutex;
+#endif
+using global_unique_lock_type = std::unique_lock<global_mutex_type>;
+
 // The global critical region mutex singleton.
 // This must guard any operation that may suspend threads or be sensitive to
 // being suspended such as global table locks and such.
@@ -55,30 +82,30 @@ namespace rex::thread {
 // };
 class global_critical_region {
  public:
-  static std::recursive_mutex& mutex();
+  static global_mutex_type& mutex();
 
   // Acquires a lock on the global critical section.
   // Use this when keeping an instance is not possible. Otherwise, prefer
   // to keep an instance of global_critical_region near the members requiring
   // it to keep things readable.
-  static std::unique_lock<std::recursive_mutex> AcquireDirect() {
-    return std::unique_lock<std::recursive_mutex>(mutex());
+  static global_unique_lock_type AcquireDirect() {
+    return global_unique_lock_type(mutex());
   }
 
   // Acquires a lock on the global critical section.
-  inline std::unique_lock<std::recursive_mutex> Acquire() {
-    return std::unique_lock<std::recursive_mutex>(mutex());
+  inline global_unique_lock_type Acquire() {
+    return global_unique_lock_type(mutex());
   }
 
   // Acquires a deferred lock on the global critical section.
-  inline std::unique_lock<std::recursive_mutex> AcquireDeferred() {
-    return std::unique_lock<std::recursive_mutex>(mutex(), std::defer_lock);
+  inline global_unique_lock_type AcquireDeferred() {
+    return global_unique_lock_type(mutex(), std::defer_lock);
   }
 
   // Tries to acquire a lock on the glboal critical section.
   // Check owns_lock() to see if the lock was successfully acquired.
-  inline std::unique_lock<std::recursive_mutex> TryAcquire() {
-    return std::unique_lock<std::recursive_mutex>(mutex(), std::try_to_lock);
+  inline global_unique_lock_type TryAcquire() {
+    return global_unique_lock_type(mutex(), std::try_to_lock);
   }
 };
 
diff --git a/src/core/mutex.cpp b/src/core/mutex.cpp
index d639924..31c6ac4 100644
--- a/src/core/mutex.cpp
+++ b/src/core/mutex.cpp
@@ -11,10 +11,50 @@
 
 #include <rex/thread/mutex.h>
 
+#if defined(_WIN32)
+#include "platform_win.h"
+#endif
+
 namespace rex::thread {
 
-std::recursive_mutex& global_critical_region::mutex() {
-  static std::recursive_mutex global_mutex;
+#if defined(_WIN32)
+static_assert(sizeof(void*) == sizeof(SRWLOCK));
+
+void global_mutex_type::lock() {
+  uint32_t self = GetCurrentThreadId();
+  if (owner_thread_.load(std::memory_order_relaxed) == self) {
+    ++recursion_count_;
+    return;
+  }
+  AcquireSRWLockExclusive(reinterpret_cast<PSRWLOCK>(&srwlock_));
+  owner_thread_.store(self, std::memory_order_relaxed);
+  recursion_count_ = 1;
+}
+
+void global_mutex_type::unlock() {
+  if (--recursion_count_ == 0) {
+    owner_thread_.store(0, std::memory_order_relaxed);
+    ReleaseSRWLockExclusive(reinterpret_cast<PSRWLOCK>(&srwlock_));
+  }
+}
+
+bool global_mutex_type::try_lock() {
+  uint32_t self = GetCurrentThreadId();
+  if (owner_thread_.load(std::memory_order_relaxed) == self) {
+    ++recursion_count_;
+    return true;
+  }
+  if (!TryAcquireSRWLockExclusive(reinterpret_cast<PSRWLOCK>(&srwlock_))) {
+    return false;
+  }
+  owner_thread_.store(self, std::memory_order_relaxed);
+  recursion_count_ = 1;
+  return true;
+}
+#endif
+
+global_mutex_type& global_critical_region::mutex() {
+  static global_mutex_type global_mutex;
   return global_mutex;
 }
 
