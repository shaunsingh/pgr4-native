+REXCVAR_DEFINE_BOOL(enable_xmp, true, "Audio", "Enables Music Player playback.");
+REXCVAR_DEFINE_DOUBLE(xmp_default_volume, 0.7, "Audio",
+                      "Music Player volume (0.0-1.0) until the title sets one. Stands in for "
+                      "the dashboard music volume setting, which defaults to 0.7.");
+
+namespace rex::audio {
+
+namespace {
+
+// Same budget as a guest audio client: about 1.1 s of 44.1 kHz stereo.
+constexpr uint32_t kQueuedFrames = 64;
+constexpr int kAvioBufferSize = 32 * 1024;
+// Longest a playing driver may go without returning a slot before the end of
+// a song stops waiting for it.
+constexpr std::chrono::milliseconds kDrainStallTimeout{250};
+
+struct SongReader {
+  const uint8_t* data;
+  int64_t size;
+  int64_t position;
+};
+
+int ReadSong(void* opaque, uint8_t* buffer, int buffer_size) {
+  auto* reader = static_cast<SongReader*>(opaque);
+  const int64_t left = reader->size - reader->position;
+  if (left <= 0) {
+    return AVERROR_EOF;
+  }
+  const int count = static_cast<int>(std::min<int64_t>(buffer_size, left));
+  std::memcpy(buffer, reader->data + reader->position, count);
+  reader->position += count;
+  return count;
+}
+
+int64_t SeekSong(void* opaque, int64_t offset, int whence) {
+  auto* reader = static_cast<SongReader*>(opaque);
+  if (whence & AVSEEK_SIZE) {
+    return reader->size;
+  }
+  int64_t position;
+  switch (whence & ~AVSEEK_FORCE) {
+    case SEEK_SET:
+      position = offset;
+      break;
+    case SEEK_CUR:
+      position = reader->position + offset;
+      break;
+    case SEEK_END:
+      position = reader->size + offset;
+      break;
+    default:
+      return AVERROR(EINVAL);
+  }
+  if (position < 0 || position > reader->size) {
+    return AVERROR(EINVAL);
+  }
+  reader->position = position;
+  return position;
+}
+
+// Opens the first audio stream of a song already in memory. The demuxer reads
+// through io, which the caller keeps and frees.
+bool OpenSong(AVIOContext* io, AVFormatContext** out_format, AVCodecContext** out_codec,
+              int* out_stream_index) {
+  AVFormatContext* format_context = avformat_alloc_context();
+  if (!format_context) {
+    return false;
+  }
+  format_context->pb = io;
+  // Frees format_context on failure.
+  int ret = avformat_open_input(&format_context, nullptr, nullptr, nullptr);
+  if (ret < 0) {
+    REXAPU_ERROR("AudioMediaPlayer: avformat_open_input failed: {:X}", ret);
+    return false;
+  }
+  *out_format = format_context;
+
+  ret = avformat_find_stream_info(format_context, nullptr);
+  if (ret < 0) {
+    REXAPU_ERROR("AudioMediaPlayer: avformat_find_stream_info failed: {:X}", ret);
+    return false;
+  }
+  const int stream_index =
+      av_find_best_stream(format_context, AVMEDIA_TYPE_AUDIO, -1, -1, nullptr, 0);
+  if (stream_index < 0) {
+    REXAPU_ERROR("AudioMediaPlayer: no audio stream");
+    return false;
+  }
+  const AVCodecParameters* parameters = format_context->streams[stream_index]->codecpar;
+  const AVCodec* decoder = avcodec_find_decoder(parameters->codec_id);
+  if (!decoder) {
+    REXAPU_ERROR("AudioMediaPlayer: no decoder for codec {}",
+                 static_cast<int>(parameters->codec_id));
+    return false;
+  }
+  AVCodecContext* codec_context = avcodec_alloc_context3(decoder);
+  if (!codec_context) {
+    return false;
+  }
+  *out_codec = codec_context;
+  ret = avcodec_parameters_to_context(codec_context, parameters);
+  if (ret < 0) {
+    return false;
+  }
+  ret = avcodec_open2(codec_context, decoder, nullptr);
+  if (ret < 0) {
+    REXAPU_ERROR("AudioMediaPlayer: avcodec_open2 failed: {:X}", ret);
+    return false;
+  }
+  *out_stream_index = stream_index;
+  return true;
+}
