+AudioMediaPlayer::AudioMediaPlayer(AudioSystem* audio_system, system::KernelState* kernel_state)
+    : volume_(static_cast<float>(std::clamp(REXCVAR_GET(xmp_default_volume), 0.0, 1.0))),
+      audio_system_(audio_system),
+      kernel_state_(kernel_state) {}
+
+AudioMediaPlayer::~AudioMediaPlayer() {
+  Shutdown();
+}
+
+void AudioMediaPlayer::Setup() {
+  if (!REXCVAR_GET(enable_xmp)) {
+    return;
+  }
+
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (worker_thread_) {
+    return;
+  }
+  worker_running_ = true;
+  worker_thread_ = rex::thread::Thread::Create({}, [this] { WorkerThreadMain(); });
+  if (!worker_thread_) {
+    worker_running_ = false;
+    REXAPU_ERROR("AudioMediaPlayer: failed to create the worker thread");
+    return;
+  }
+  worker_thread_->set_name("Audio Media Player");
+}
+
+void AudioMediaPlayer::Shutdown() {
+  {
+    std::unique_lock<std::mutex> lock(mutex_);
+    StopLocked(lock, true);
+    worker_running_ = false;
+    worker_cv_.notify_all();
+  }
+  if (worker_thread_) {
+    rex::thread::Wait(worker_thread_.get(), false);
+    worker_thread_.reset();
+  }
+  DeleteDriver();
+}
+
+void AudioMediaPlayer::WorkerThreadMain() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  while (true) {
+    worker_cv_.wait(lock, [this] { return !worker_running_ || start_requested_; });
+    if (!worker_running_) {
+      break;
+    }
+    start_requested_ = false;
+    XmpApp::Song* song = active_song_.load(std::memory_order_relaxed);
+    if (!song) {
+      continue;
+    }
+    // The playlist can go away while the song plays, so the worker keeps its
+    // own copy of what it needs.
+    Request request;
+    request.file_path = song->file_path;
+    request.song_handle = song->handle;
+    request.serial = stop_serial_.load(std::memory_order_relaxed);
+    in_play_ = true;
+
+    lock.unlock();
+    PlaySong(request);
+    lock.lock();
+  }
+}
+
+X_STATUS AudioMediaPlayer::Play(uint32_t playlist_handle, uint32_t song_handle, bool force) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  if (!FindPlaylistLocked(playlist_handle)) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+
+  // I've set it to false (force) for PGR3
+  if (!IsIdle() || IsSongLoaded() || in_play_) {
+    StopLocked(lock, force);
+  }
+
+  // Look again: the wait for the worker released the lock.
+  XmpApp::Playlist* playlist = FindPlaylistLocked(playlist_handle);
+  if (!playlist || playlist->songs.empty()) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  active_playlist_ = playlist;
+
+  if (!song_handle) {
+    StartLocked(playlist->songs.front().get());
+    return X_STATUS_SUCCESS;
+  }
+
+  auto song_itr = std::ranges::find_if(
+      std::as_const(playlist->songs),
+      [song_handle](const std::unique_ptr<XmpApp::Song>& song) {
+        return song->handle == song_handle;
+      });
+  if (song_itr == playlist->songs.cend()) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+
+  StartLocked(song_itr->get());
+  return X_STATUS_SUCCESS;
+}
+
+void AudioMediaPlayer::PlaySong(const Request& request) {
+  std::span<uint8_t> song_buffer = LoadSongToMemory(request.file_path);
+  if (song_buffer.empty()) {
+    REXAPU_ERROR("AudioMediaPlayer: cannot read {}", rex::string::to_utf8(request.file_path));
+    EndSong(request, PlayResult::kFailure);
+    return;
+  }
+
+  SongReader reader = {song_buffer.data(), static_cast<int64_t>(song_buffer.size()), 0};
+  AVIOContext* io = nullptr;
+  if (auto* io_buffer = static_cast<uint8_t*>(av_malloc(kAvioBufferSize))) {
+    io = avio_alloc_context(io_buffer, kAvioBufferSize, 0, &reader, ReadSong, nullptr, SeekSong);
+    if (!io) {
+      av_free(io_buffer);
+    }
+  }
+
+  AVFormatContext* format_context = nullptr;
+  AVCodecContext* codec_context = nullptr;
+  int stream_index = -1;
+  PlayResult result = PlayResult::kFailure;
+  if (io && OpenSong(io, &format_context, &codec_context, &stream_index)) {
+    if (SetupDriver(codec_context->sample_rate, codec_context->channels)) {
+      bool started = false;
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (IsCurrent(request)) {
+          state_.store(XmpApp::State::kPlaying, std::memory_order_release);
+          started = true;
+        }
+      }
+      if (started) {
+        OnStateChanged();
+        {
+          std::lock_guard<std::mutex> guard(driver_mutex_);
+          // Always apply the stored volume to the newly created driver
+          driver_->SetVolume(volume_);
+        }
+        result = DecodeSong(request, format_context, codec_context, stream_index);
+        if (result == PlayResult::kSuccessful) {
+          DrainDriver(request);
+        }
+      } else {
+        result = PlayResult::kForcedFinish;
+      }
+    } else {
+      REXAPU_ERROR("AudioMediaPlayer: driver initialization failed");
+    }
+  } else {
+    REXAPU_ERROR("AudioMediaPlayer: cannot decode {}", rex::string::to_utf8(request.file_path));
+  }
+
+  // Cleanup after work. The demuxer does not own a caller-supplied AVIO context.
+  avcodec_free_context(&codec_context);
+  avformat_close_input(&format_context);
+  if (io) {
+    av_freep(&io->buffer);
+    avio_context_free(&io);
+  }
+  av_free(song_buffer.data());
+
+  EndSong(request, result);
+}
+
+AudioMediaPlayer::PlayResult AudioMediaPlayer::DecodeSong(const Request& request,
+                                                          AVFormatContext* format_context,
+                                                          AVCodecContext* codec_context,
+                                                          int stream_index) {
+  AVPacket* packet = av_packet_alloc();
+  AVFrame* frame = av_frame_alloc();
+  if (!packet || !frame) {
+    av_frame_free(&frame);
+    av_packet_free(&packet);
+    return PlayResult::kFailure;
+  }
+
+  const int channel_count = codec_context->channels;
+  PlayResult result = PlayResult::kSuccessful;
+  pending_count_ = 0;
+  bool end_of_file = false;
+  while (!end_of_file && result == PlayResult::kSuccessful) {
+    if (!IsCurrent(request)) {
+      result = PlayResult::kForcedFinish;
+      break;
+    }
+
+    int ret = av_read_frame(format_context, packet);
+    if (ret < 0) {
+      // Drain the decoder, which still holds the last frame.
+      end_of_file = true;
+      ret = avcodec_send_packet(codec_context, nullptr);
+    } else if (packet->stream_index != stream_index) {
+      av_packet_unref(packet);
+      continue;
+    } else {
+      ret = avcodec_send_packet(codec_context, packet);
+      av_packet_unref(packet);
+    }
+    if (ret < 0) {
+      REXAPU_WARN("AudioMediaPlayer: error sending packet for decoding: {:X}", ret);
+      continue;
+    }
+
+    while (true) {
+      ret = avcodec_receive_frame(codec_context, frame);
+      if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) {
+        break;
+      }
+      if (ret < 0) {
+        REXAPU_WARN("AudioMediaPlayer: error during decoding: {:X}", ret);
+        break;
+      }
+      if (!QueueFrame(request, frame, channel_count)) {
+        result = PlayResult::kForcedFinish;
+        break;
+      }
+    }
+  }
+
+  // The tail of the song is shorter than a frame; pad it rather than drop it.
+  if (result == PlayResult::kSuccessful && pending_count_) {
+    std::fill(pending_samples_.begin() + pending_count_,
+              pending_samples_.begin() + AudioDriver::kFrameSamplesMax, 0.0f);
+    if (!SubmitFrame(request, pending_samples_.data())) {
+      result = PlayResult::kForcedFinish;
+    }
+  }
+  pending_count_ = 0;
+
+  av_frame_free(&frame);
+  av_packet_free(&packet);
+  return result;
+}
+
+bool AudioMediaPlayer::QueueFrame(const Request& request, const AVFrame* frame,
+                                  int channel_count) {
+  const size_t frame_samples = static_cast<size_t>(frame->nb_samples) * channel_count;
+  const size_t needed =
+      std::max<size_t>(pending_count_ + frame_samples, AudioDriver::kFrameSamplesMax);
+  if (pending_samples_.size() < needed) {
+    pending_samples_.resize(needed);
+  }
+
+  float* out = pending_samples_.data() + pending_count_;
+  switch (frame->format) {
+    case AV_SAMPLE_FMT_FLTP:
+      for (int sample = 0; sample < frame->nb_samples; sample++) {
+        for (int ch = 0; ch < channel_count; ch++) {
+          *out++ = reinterpret_cast<const float*>(frame->data[ch])[sample];
+        }
+      }
+      break;
+    case AV_SAMPLE_FMT_FLT:
+      std::memcpy(out, frame->data[0], frame_samples * sizeof(float));
+      break;
+    default:
+      return true;
+  }
+  pending_count_ += frame_samples;
+
+  size_t offset = 0;
+  while (pending_count_ - offset >= AudioDriver::kFrameSamplesMax) {
+    if (!SubmitFrame(request, pending_samples_.data() + offset)) {
+      pending_count_ = 0;
+      return false;
+    }
+    offset += AudioDriver::kFrameSamplesMax;
+  }
+  if (offset) {
+    pending_count_ -= offset;
+    std::memmove(pending_samples_.data(), pending_samples_.data() + offset,
+                 pending_count_ * sizeof(float));
+  }
+  return true;
+}
+
+bool AudioMediaPlayer::SubmitFrame(const Request& request, float* samples) {
+  // Stop releases a slot to get the worker out of this wait.
+  rex::thread::Wait(driver_semaphore_.get(), false);
+  if (!IsCurrent(request)) {
+    return false;
+  }
+
+  // XMP should be processed on Audio thread. Some games goes insane when they
+  // have additional unexpected guest thread (NG2 for example). Canary leaves the
+  // XMPCaptureOutput callback disabled for that reason, and so does this port.
+  driver_->SubmitFrame(samples);
+  return true;
+}
+
+void AudioMediaPlayer::DrainDriver(const Request& request) {
+  // Every slot back means the driver has played every frame of the song. Canary
+  // waits for one slot only, and the next song's driver drops the rest.
+  uint32_t returned = 0;
+  while (returned < kQueuedFrames && IsCurrent(request)) {
+    if (rex::thread::Wait(driver_semaphore_.get(), false, kDrainStallTimeout) ==
+        rex::thread::WaitResult::kSuccess) {
+      ++returned;
+    } else if (!IsPaused()) {
+      break;
+    }
+  }
+}
+
+void AudioMediaPlayer::EndSong(const Request& request, PlayResult result) {
+  bool state_changed = false;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    in_play_ = false;
+    // A Stop, Next, Previous or Play since the song was picked already chose
+    // what happens next.
+    if (IsCurrent(request)) {
+      state_changed = !IsIdle();
+      state_.store(XmpApp::State::kIdle, std::memory_order_release);
+      active_song_.store(nullptr, std::memory_order_release);
+      if (result == PlayResult::kSuccessful && active_playlist_ &&
+          !active_playlist_->songs.empty()) {
+        if (!IsLastSongInPlaylistLocked()) {
+          if (XmpApp::Song* next = AdjacentSongLocked(true)) {
+            StartLocked(next);
+          }
+        } else if (IsInRepeatMode()) {
+          // We're after last song in playlist
+          StartLocked(active_playlist_->songs.front().get());
+        }
+      }
+    }
+    worker_cv_.notify_all();
+  }
+
+  if (state_changed) {
+    OnStateChanged();
+  }
+  // A drained driver has nothing left to play, and one that was stopped must
+  // not play out its queue.
+  DeleteDriver();
+}
+
+void AudioMediaPlayer::Pause() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!IsPlaying()) {
+      return;
+    }
+    {
+      std::lock_guard<std::mutex> guard(driver_mutex_);
+      if (driver_) {
+        driver_->Pause();
+      }
+    }
+    state_.store(XmpApp::State::kPaused, std::memory_order_release);
+  }
+  OnStateChanged();
+}
+
+void AudioMediaPlayer::Stop(bool change_state, bool force) {
+  bool was_active;
+  {
+    std::unique_lock<std::mutex> lock(mutex_);
+    was_active = StopLocked(lock, force);
+  }
+  if (was_active && change_state) {
+    OnStateChanged();
+  }
+}
+
+bool AudioMediaPlayer::StopLocked(std::unique_lock<std::mutex>& lock, bool force) {
+  start_requested_ = false;
+  const bool was_active = !IsIdle();
+  if (!was_active && !IsSongLoaded() && !in_play_) {
+    return false;
+  }
+
+  state_.store(XmpApp::State::kIdle, std::memory_order_release);
+  active_song_.store(nullptr, std::memory_order_release);
+  stop_serial_.fetch_add(1, std::memory_order_acq_rel);
+  // A paused driver returns no slots, so wake the worker rather than resume
+  // the driver and let the queued audio play out.
+  WakeWorker();
+
+  if (!force) {
+    worker_cv_.wait(lock, [this] { return !in_play_; });
+  }
+  return was_active;
+}
+
+void AudioMediaPlayer::StartLocked(XmpApp::Song* song) {
+  active_song_.store(song, std::memory_order_release);
+  current_song_handle_ = song->handle;
+  start_requested_ = true;
+  worker_cv_.notify_all();
+}
+
+void AudioMediaPlayer::WakeWorker() {
+  std::lock_guard<std::mutex> guard(driver_mutex_);
+  if (driver_semaphore_) {
+    driver_semaphore_->Release(1, nullptr);
+  }
+}
+
+void AudioMediaPlayer::Continue() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!IsPaused()) {
+      return;
+    }
+    state_.store(XmpApp::State::kPlaying, std::memory_order_release);
+    std::lock_guard<std::mutex> guard(driver_mutex_);
+    if (driver_) {
+      driver_->Resume();
+    }
+  }
+  OnStateChanged();
+}
+
+X_STATUS AudioMediaPlayer::Next() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  if (!active_playlist_) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+
+  if (IsSongLoaded() || in_play_) {
+    StopLocked(lock, false);
+  }
+
+  // There is no song with such ID?
+  XmpApp::Song* song = AdjacentSongLocked(true);
+  if (!song) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  StartLocked(song);
+  return X_STATUS_SUCCESS;
+}
+
+X_STATUS AudioMediaPlayer::Previous() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  if (!active_playlist_) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+
+  if (IsSongLoaded() || in_play_) {
+    StopLocked(lock, false);
+  }
+
+  XmpApp::Song* song = AdjacentSongLocked(false);
+  if (!song) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  StartLocked(song);
+  return X_STATUS_SUCCESS;
+}
+
+XmpApp::Song* AudioMediaPlayer::AdjacentSongLocked(bool forward) const {
+  if (!active_playlist_ || active_playlist_->songs.empty()) {
+    return nullptr;
+  }
+  const auto& songs = active_playlist_->songs;
+  auto itr = std::ranges::find_if(songs, [this](const std::unique_ptr<XmpApp::Song>& song) {
+    return song->handle == current_song_handle_;
+  });
+  if (itr == songs.cend()) {
+    return nullptr;
+  }
+
+  if (forward) {
+    itr = std::next(itr);
+    return itr != songs.cend() ? itr->get() : songs.front().get();
+  }
+  // We're at the first entry, we need to go to the end.
+  if (itr == songs.cbegin()) {
+    return songs.back().get();
+  }
+  return std::prev(itr)->get();
+}
+
+XmpApp::Playlist* AudioMediaPlayer::FindPlaylistLocked(uint32_t handle) const {
+  auto itr = playlists_.find(handle);
+  return itr != playlists_.cend() ? itr->second.get() : nullptr;
+}
+
+std::span<uint8_t> AudioMediaPlayer::LoadSongToMemory(const std::u16string& file_path) {
+  // Find file based on provided path?
+  filesystem::File* vfs_file = nullptr;
+  filesystem::FileAction file_action;
+  X_STATUS result = kernel_state_->file_system()->OpenFile(
+      nullptr, rex::string::to_utf8(file_path), filesystem::FileDisposition::kOpen,
+      filesystem::FileAccess::kGenericRead, false, true, &vfs_file, &file_action);
+  if (result != X_STATUS_SUCCESS || !vfs_file) {
+    return {};
+  }
+
+  const size_t file_size = vfs_file->entry()->size();
+  uint8_t* data = file_size ? static_cast<uint8_t*>(av_malloc(file_size)) : nullptr;
+  if (!data) {
+    vfs_file->Destroy();
+    return {};
+  }
+  std::span<uint8_t> buffer = {data, file_size};
+
+  size_t bytes_read = 0;
+  result = vfs_file->ReadSync(buffer, 0, &bytes_read);
+  vfs_file->Destroy();
+  if (result != X_STATUS_SUCCESS || bytes_read != file_size) {
+    // Read failed. We need to manually release resources from av_malloc.
+    av_free(data);
+    return {};
+  }
+
+  return buffer;
+}
+
+void AudioMediaPlayer::AddPlaylist(uint32_t handle, std::unique_ptr<XmpApp::Playlist> playlist) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (playlists_.count(handle) != 0) {
+    return;
+  }
+
+  if (playback_mode_ == XmpApp::PlaybackMode::kShuffle) {
+    auto rng = std::default_random_engine{};
+    std::ranges::shuffle(playlist->songs, rng);
+  }
+
+  playlists_.insert({handle, std::move(playlist)});
+}
+
+void AudioMediaPlayer::RemovePlaylist(uint32_t handle) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  if (playlists_.count(handle) == 0) {
+    return;
+  }
+
+  // The worker may still be reading the song, so wait for it before the
+  // playlist goes.
+  if (playlists_[handle].get() == active_playlist_) {
+    StopLocked(lock, false);
+    active_playlist_ = nullptr;
+  }
+
+  playlists_.erase(handle);
+}
+
+X_STATUS AudioMediaPlayer::SetVolume(float volume) {
+  volume_.store(std::min(volume, 1.0f));
+
+  std::lock_guard<std::mutex> guard(driver_mutex_);
+  if (!driver_) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+
+  driver_->SetVolume(volume_);
+  return X_STATUS_SUCCESS;
+}
+
+AudioMediaPlayer::ControllerSettings& AudioMediaPlayer::GetControllerSettings(
+    XMP_CLIENT xmp_client) {
+  PlaybackController controller = PlaybackController::User;
+  if (xmp_client == XMP_CLIENT::Game) {
+    controller = PlaybackController::Game;
+  } else if (xmp_client == XMP_CLIENT::MCE) {
+    controller = PlaybackController::MCE;
+  }
+
+  return controller_settings_[uint32_t(controller)];
+}
+
+void AudioMediaPlayer::SetPlaybackController(PlaybackController playback_controller) {
+  const bool changed = playback_controller != playback_controller_;
+  playback_controller_ = playback_controller;
+  if (!changed || uint32_t(playback_controller) >= std::size(controller_settings_)) {
+    return;
+  }
+
+  const ControllerSettings& settings = controller_settings_[uint32_t(playback_controller)];
+  SetPlaybackMode(settings.playback_mode);
+  SetRepeatMode(settings.repeat_mode);
+  SetPlaybackFlags(settings.playback_flags);
+  SetVolume(settings.volume);
+}
+
+bool AudioMediaPlayer::IsLastSongInPlaylist() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return IsLastSongInPlaylistLocked();
+}
+
+bool AudioMediaPlayer::IsLastSongInPlaylistLocked() const {
+  if (!active_playlist_) {
+    return false;
+  }
+
+  const auto& songs = active_playlist_->songs;
+  auto itr = std::ranges::find_if(songs, [this](const std::unique_ptr<XmpApp::Song>& song) {
+    return song->handle == current_song_handle_;
+  });
+  return itr == songs.cend() || std::next(itr) == songs.cend();
+}
+
+void AudioMediaPlayer::SetCaptureCallback([[maybe_unused]] uint32_t callback, uint32_t context,
+                                          [[maybe_unused]] bool title_render) {
+  // TODO: Something is incorrect with callback and causes audio to be muted!
+  callback_ = 0;
+  callback_context_ = context;
+  is_title_rendering_enabled_ = false;  // title_render;
+}
+
+void AudioMediaPlayer::OnStateChanged() {
+  kernel_state_->BroadcastNotification(kernel::xam::apps::kXNotificationXmpStateChanged,
+                                       static_cast<uint32_t>(GetState()));
+}
+
+bool AudioMediaPlayer::SetupDriver(uint32_t sample_rate, uint32_t channels) {
+  DeleteDriver();
+
+  std::lock_guard<std::mutex> guard(driver_mutex_);
+  if (!sample_rate || !channels || channels > AudioDriver::kFrameSamplesMax) {
+    return false;
+  }
+  driver_semaphore_ = rex::thread::Semaphore::Create(kQueuedFrames, kQueuedFrames);
+
+  if (!driver_semaphore_) {
+    return false;
+  }
+
+  if (audio_system_) {
+    driver_.reset(
+        audio_system_->CreateDriver(driver_semaphore_.get(), sample_rate, channels, false));
+  }
+  if (driver_ && driver_->Initialize()) {
+    return true;
+  }
+  if (driver_) {
+    driver_->Shutdown();
+    driver_.reset();
+  }
+  driver_ = std::make_unique<PacingAudioDriver>(driver_semaphore_.get(), sample_rate,
+                                                AudioDriver::kFrameSamplesMax / channels);
+  if (!driver_->Initialize()) {
+    driver_.reset();
+    driver_semaphore_.reset();
+    return false;
+  }
+  REXAPU_WARN("APU: failed to create or initialize a media driver; continuing silently");
+
+  return true;
+}
+
+void AudioMediaPlayer::DeleteDriver() {
+  std::lock_guard<std::mutex> guard(driver_mutex_);
+  if (driver_) {
+    // Stop the driver before destroying the semaphore used by its callbacks.
+    driver_->Shutdown();
+    driver_.reset();
+  }
+  driver_semaphore_.reset();
+}
+
