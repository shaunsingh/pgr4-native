+/**
+ * @file        audio/wma_file.h
+ * @brief       Incremental decoder for WMA music files
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <cstddef>
+#include <filesystem>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace rex::audio {
+
+// Decodes a Windows Media Audio (version 1 or 2) file to interleaved 32-bit float PCM as it is
+// read. The ASF reader covers what audio-only encoders write: one audio stream in fixed-size data
+// packets, single or multiple payloads, media objects fragmented across packets. It rejects
+// compressed payloads and scrambled (audio spread) streams.
+class WmaFileDecoder {
+ public:
+  WmaFileDecoder();
+  ~WmaFileDecoder();
+  WmaFileDecoder(const WmaFileDecoder&) = delete;
+  WmaFileDecoder& operator=(const WmaFileDecoder&) = delete;
+
+  // Reads the headers and opens the codec. False, with error() set, on failure.
+  bool Open(const std::filesystem::path& path);
+
+  // Appends samples to `out` until it holds at least `samples` (counting every channel) or the
+  // file ends. False, with error() set, on a failure.
+  bool Decode(size_t samples, std::vector<float>& out);
+
+  int sample_rate() const;
+  int channels() const;
+  bool ended() const;
+  const std::string& error() const;
+
+ private:
+  struct State;
+  std::unique_ptr<State> state_;
+};
+
+}  // namespace rex::audio
