+/**
+ * @file        audio/wma_file.cpp
+ * @brief       Incremental decoder for WMA music files: a minimal ASF reader feeding FFmpeg
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#include <rex/audio/wma_file.h>
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <fstream>
+#include <limits>
+#include <span>
+
+extern "C" {
+#if defined(_MSC_VER)
+#pragma warning(push)
+#pragma warning(disable : 4244)
+#endif
+#include "libavcodec/avcodec.h"
+#include "libavutil/error.h"
+#include "libavutil/mem.h"
+#if defined(_MSC_VER)
+#pragma warning(pop)
+#endif
+}  // extern "C"
+
+namespace rex::audio {
+namespace {
+
+static_assert(std::endian::native == std::endian::little, "ASF fields are read in place");
+
+using Guid = std::array<uint8_t, 16>;
+
+// GUIDs as stored in the file: the first three fields little-endian.
+constexpr Guid kHeaderObject{0x30, 0x26, 0xB2, 0x75, 0x8E, 0x66, 0xCF, 0x11,
+                             0xA6, 0xD9, 0x00, 0xAA, 0x00, 0x62, 0xCE, 0x6C};
+constexpr Guid kDataObject{0x36, 0x26, 0xB2, 0x75, 0x8E, 0x66, 0xCF, 0x11,
+                           0xA6, 0xD9, 0x00, 0xAA, 0x00, 0x62, 0xCE, 0x6C};
+constexpr Guid kFilePropertiesObject{0xA1, 0xDC, 0xAB, 0x8C, 0x47, 0xA9, 0xCF, 0x11,
+                                     0x8E, 0xE4, 0x00, 0xC0, 0x0C, 0x20, 0x53, 0x65};
+constexpr Guid kStreamPropertiesObject{0x91, 0x07, 0xDC, 0xB7, 0xB7, 0xA9, 0xCF, 0x11,
+                                       0x8E, 0xE6, 0x00, 0xC0, 0x0C, 0x20, 0x53, 0x65};
+constexpr Guid kAudioMedia{0x40, 0x9E, 0x69, 0xF8, 0x4D, 0x5B, 0xCF, 0x11,
+                           0xA8, 0xFD, 0x00, 0x80, 0x5F, 0x5C, 0x44, 0x2B};
+constexpr Guid kAudioSpread{0x50, 0xCD, 0xC3, 0xBF, 0x8F, 0x61, 0xCF, 0x11,
+                            0x8B, 0xB2, 0x00, 0xAA, 0x00, 0xB4, 0xE2, 0x20};
+
+constexpr size_t kObjectHeaderSize = 24;        // GUID, size
+constexpr size_t kHeaderObjectSize = 30;        // + object count, two reserved bytes
+constexpr size_t kDataObjectSize = 50;          // + file ID, packet count, reserved
+constexpr uint64_t kMaxHeaderSize = 1u << 20;
+constexpr uint32_t kMaxPacketSize = 1u << 20;
+constexpr uint32_t kMaxMediaObjectSize = 1u << 24;
+
+constexpr uint16_t kFormatWmaV1 = 0x0160;
+constexpr uint16_t kFormatWmaV2 = 0x0161;
+
+// Bounds-checked little-endian reader. A read past the end yields zeros and clears ok().
+class Reader {
+ public:
+  explicit Reader(std::span<const uint8_t> data) : data_(data) {}
+
+  bool ok() const { return ok_; }
+  size_t position() const { return position_; }
+  size_t remaining() const { return data_.size() - position_; }
+
+  std::span<const uint8_t> Bytes(size_t count) {
+    if (count > remaining()) {
+      ok_ = false;
+      position_ = data_.size();
+      return {};
+    }
+    const auto bytes = data_.subspan(position_, count);
+    position_ += count;
+    return bytes;
+  }
+
+  void Skip(size_t count) { Bytes(count); }
+
+  template <typename T>
+  T Read() {
+    T value{};
+    if (const auto bytes = Bytes(sizeof(T)); !bytes.empty()) {
+      std::memcpy(&value, bytes.data(), sizeof(T));
+    }
+    return value;
+  }
+
+  Guid ReadGuid() { return Read<Guid>(); }
+
+  // An ASF field whose size is a 2-bit length type: absent, BYTE, WORD or DWORD.
+  uint32_t ReadField(unsigned length_type) {
+    switch (length_type & 3) {
+      case 1:
+        return Read<uint8_t>();
+      case 2:
+        return Read<uint16_t>();
+      case 3:
+        return Read<uint32_t>();
+      default:
+        return 0;
+    }
+  }
+
+ private:
+  std::span<const uint8_t> data_;
+  size_t position_ = 0;
+  bool ok_ = true;
+};
+
+// Samples per channel in one WMA v1/v2 frame, as the decoder chooses it from the sample rate.
+int WmaFrameLength(uint16_t format_tag, int sample_rate) {
+  if (sample_rate <= 16000) return 512;
+  if (sample_rate <= 22050 || (sample_rate <= 32000 && format_tag == kFormatWmaV1)) return 1024;
+  return 2048;
+}
+
+std::string AvErrorString(int error) {
+  char buffer[AV_ERROR_MAX_STRING_SIZE] = {};
+  av_strerror(error, buffer, sizeof(buffer));
+  return buffer;
+}
+
+}  // namespace
+
+struct WmaFileDecoder::State {
+  ~State() {
+    for (AVPacket* object : ready) av_packet_free(&object);
+    av_packet_free(&object);
+    av_frame_free(&frame);
+    avcodec_free_context(&codec);
+  }
+
+  bool Fail(std::string message) {
+    error = std::move(message);
+    return false;
+  }
+
+  bool ReadHeaders();
+  bool OpenCodec();
+  bool ReadPacket();
+  bool ParsePacket();
+  void AddFragment(uint32_t object_number, uint32_t offset, uint32_t object_size,
+                   std::span<const uint8_t> data);
+  AVPacket* NextObject();
+  bool AppendFrame(std::vector<float>& out);
+
+  std::ifstream file;
+  std::vector<uint8_t> packet;
+  uint64_t packets_left = 0;
+  unsigned stream_number = 0;
+
+  uint16_t format_tag = 0;
+  int channel_count = 0;
+  int sample_rate = 0;
+  uint32_t bytes_per_second = 0;
+  uint16_t block_align = 0;
+  uint16_t bits_per_sample = 0;
+  std::vector<uint8_t> codec_data;
+
+  AVCodecContext* codec = nullptr;
+  AVPacket* object = nullptr;  // the media object being assembled
+  uint32_t object_number = 0;
+  size_t object_filled = 0;
+  std::deque<AVPacket*> ready;  // complete media objects, in order
+  AVFrame* frame = nullptr;
+  size_t priming_frames = 0;  // of decoder output still to drop
+  bool flushed = false;
+  bool ended = false;
+  std::string error;
+};
+
+bool WmaFileDecoder::State::ReadHeaders() {
+  std::array<uint8_t, kHeaderObjectSize> top;
+  if (!file.read(reinterpret_cast<char*>(top.data()), top.size())) return Fail("not an ASF file");
+  Reader top_reader(top);
+  const Guid top_id = top_reader.ReadGuid();
+  const uint64_t header_size = top_reader.Read<uint64_t>();
+  const uint32_t object_count = top_reader.Read<uint32_t>();
+  if (top_id != kHeaderObject || header_size < kHeaderObjectSize || header_size > kMaxHeaderSize)
+    return Fail("not an ASF file");
+
+  std::vector<uint8_t> header(size_t(header_size - kHeaderObjectSize));
+  if (!file.read(reinterpret_cast<char*>(header.data()), std::streamsize(header.size())))
+    return Fail("truncated ASF header");
+
+  uint32_t min_packet_size = 0;
+  uint32_t max_packet_size = 0;
+  bool scrambled = false;
+  Reader objects(header);
+  for (uint32_t i = 0; i < object_count; ++i) {
+    const Guid id = objects.ReadGuid();
+    const uint64_t size = objects.Read<uint64_t>();
+    if (!objects.ok() || size < kObjectHeaderSize || size - kObjectHeaderSize > objects.remaining())
+      return Fail("malformed ASF header");
+    Reader body(objects.Bytes(size_t(size - kObjectHeaderSize)));
+    if (id == kFilePropertiesObject) {
+      // File ID, file size, creation date, packet count, play and send duration, preroll, flags.
+      body.Skip(16 + 8 * 6 + 4);
+      min_packet_size = body.Read<uint32_t>();
+      max_packet_size = body.Read<uint32_t>();
+    } else if (id == kStreamPropertiesObject && !stream_number) {
+      const Guid stream_type = body.ReadGuid();
+      const Guid correction_type = body.ReadGuid();
+      body.Skip(8);  // time offset
+      const uint32_t type_length = body.Read<uint32_t>();
+      const uint32_t correction_length = body.Read<uint32_t>();
+      const uint16_t flags = body.Read<uint16_t>();
+      body.Skip(4);
+      Reader format(body.Bytes(type_length));
+      const auto correction = body.Bytes(correction_length);
+      if (!body.ok() || stream_type != kAudioMedia) continue;
+      // An audio spread span above 1 interleaves the stream's bytes across packets.
+      scrambled = correction_type == kAudioSpread && !correction.empty() && correction[0] > 1;
+      format_tag = format.Read<uint16_t>();
+      channel_count = format.Read<uint16_t>();
+      sample_rate = int(format.Read<uint32_t>());
+      bytes_per_second = format.Read<uint32_t>();
+      block_align = format.Read<uint16_t>();
+      bits_per_sample = format.Read<uint16_t>();
+      if (!format.ok()) return Fail("malformed audio format");
+      if (format.remaining() >= 2) {
+        const uint16_t extra_size = format.Read<uint16_t>();
+        const auto extra = format.Bytes(std::min<size_t>(extra_size, format.remaining()));
+        codec_data.assign(extra.begin(), extra.end());
+      }
+      stream_number = flags & 0x7F;
+    }
+  }
+  if (!stream_number) return Fail("no audio stream");
+  if (scrambled) return Fail("scrambled audio streams are not supported");
+  if (!min_packet_size || min_packet_size != max_packet_size || min_packet_size > kMaxPacketSize)
+    return Fail("unsupported ASF packet size");
+
+  std::array<uint8_t, kDataObjectSize> data_header;
+  if (!file.read(reinterpret_cast<char*>(data_header.data()), data_header.size()))
+    return Fail("no ASF data");
+  Reader data_reader(data_header);
+  const Guid data_id = data_reader.ReadGuid();
+  const uint64_t data_size = data_reader.Read<uint64_t>();
+  data_reader.Skip(16);  // file ID
+  packets_left = data_reader.Read<uint64_t>();
+  if (data_id != kDataObject) return Fail("no ASF data");
+  // Files written as a broadcast leave the packet count, and maybe the size, unset.
+  if (!packets_left) {
+    packets_left = data_size > kDataObjectSize ? (data_size - kDataObjectSize) / min_packet_size
+                                               : std::numeric_limits<uint64_t>::max();
+  }
+  packet.resize(min_packet_size);
+  return true;
+}
+
+bool WmaFileDecoder::State::OpenCodec() {
+  const AVCodecID codec_id = format_tag == kFormatWmaV1   ? AV_CODEC_ID_WMAV1
+                             : format_tag == kFormatWmaV2 ? AV_CODEC_ID_WMAV2
+                                                          : AV_CODEC_ID_NONE;
+  const AVCodec* decoder = codec_id != AV_CODEC_ID_NONE ? avcodec_find_decoder(codec_id) : nullptr;
+  if (!decoder) {
+    char message[48];
+    std::snprintf(message, sizeof(message), "unsupported audio format 0x%04X", format_tag);
+    return Fail(message);
+  }
+  if (channel_count < 1 || channel_count > 8 || sample_rate <= 0 || !block_align)
+    return Fail("invalid audio format");
+
+  codec = avcodec_alloc_context3(decoder);
+  object = av_packet_alloc();
+  frame = av_frame_alloc();
+  if (!codec || !object || !frame) return Fail("out of memory");
+  codec->sample_rate = sample_rate;
+  codec->channels = channel_count;
+  codec->bit_rate = int64_t(bytes_per_second) * 8;
+  codec->block_align = block_align;
+  codec->bits_per_coded_sample = bits_per_sample;
+  if (!codec_data.empty()) {
+    codec->extradata =
+        static_cast<uint8_t*>(av_mallocz(codec_data.size() + AV_INPUT_BUFFER_PADDING_SIZE));
+    if (!codec->extradata) return Fail("out of memory");
+    std::memcpy(codec->extradata, codec_data.data(), codec_data.size());
+    codec->extradata_size = int(codec_data.size());
+  }
+  if (const int result = avcodec_open2(codec, decoder, nullptr); result < 0)
+    return Fail("cannot open the decoder: " + AvErrorString(result));
+  // The output lags the stream by two frames: one of zeros, then the ramp of the first
+  // overlap-add. Later FFmpeg releases drop them (skip_samples); this one leaves that to us.
+  priming_frames = 2 * size_t(WmaFrameLength(format_tag, sample_rate));
+  return true;
+}
+
+bool WmaFileDecoder::State::ReadPacket() {
+  if (!packets_left) return false;
+  if (!file.read(reinterpret_cast<char*>(packet.data()), std::streamsize(packet.size())))
+    return false;
+  --packets_left;
+  return true;
+}
+
+// Queues the media objects of the audio stream that the packet completes. A malformed packet is
+// dropped, as is a media object that misses a fragment. False, with error set, on content this
+// reader does not support.
+bool WmaFileDecoder::State::ParsePacket() {
+  Reader reader(packet);
+  uint8_t length_flags = reader.Read<uint8_t>();
+  if (length_flags & 0x80) {
+    // Error correction data, of the length in the low 4 bits when the length type is 0.
+    if (length_flags & 0x60) return true;
+    reader.Skip(length_flags & 0x0F);
+    length_flags = reader.Read<uint8_t>();
+  }
+  const uint8_t property_flags = reader.Read<uint8_t>();
+  size_t packet_length = reader.ReadField(length_flags >> 5);
+  reader.ReadField(length_flags >> 1);  // sequence
+  const size_t padding_length = reader.ReadField(length_flags >> 3);
+  reader.Skip(6);  // send time, duration
+  // A packet shorter than the fixed size is padded to it.
+  if (!packet_length || packet_length > packet.size()) packet_length = packet.size();
+  if (!reader.ok() || reader.position() > packet_length ||
+      padding_length > packet_length - reader.position())
+    return true;
+  const size_t payload_end = packet_length - padding_length;
+
+  const unsigned replicated_length_type = property_flags & 3;
+  const unsigned offset_type = (property_flags >> 2) & 3;
+  const unsigned object_number_type = (property_flags >> 4) & 3;
+  const bool multiple_payloads = length_flags & 1;
+  unsigned payload_count = 1;
+  unsigned payload_length_type = 0;
+  if (multiple_payloads) {
+    const uint8_t payload_flags = reader.Read<uint8_t>();
+    payload_count = payload_flags & 0x3F;
+    payload_length_type = payload_flags >> 6;
+  }
+  for (unsigned i = 0; i < payload_count; ++i) {
+    const unsigned stream = reader.Read<uint8_t>() & 0x7F;
+    const uint32_t number = reader.ReadField(object_number_type);
+    const uint32_t offset = reader.ReadField(offset_type);
+    const uint32_t replicated_length = reader.ReadField(replicated_length_type);
+    const auto replicated = reader.Bytes(replicated_length);
+    size_t length = 0;
+    if (multiple_payloads) {
+      length = reader.ReadField(payload_length_type);
+    } else if (reader.position() < payload_end) {
+      length = payload_end - reader.position();
+    }
+    const auto data = reader.Bytes(length);
+    if (!reader.ok() || reader.position() > payload_end) return true;
+    if (stream != stream_number) continue;
+    // A replicated data length of 1 marks a compressed payload: several small media objects
+    // without fragment offsets. Audio encoders do not write them.
+    if (replicated_length == 1) return Fail("compressed ASF payloads are not supported");
+    uint32_t object_size = uint32_t(length);
+    if (replicated.size() >= 4) std::memcpy(&object_size, replicated.data(), 4);
+    AddFragment(number, offset, object_size, data);
+  }
+  return true;
+}
+
+void WmaFileDecoder::State::AddFragment(uint32_t number, uint32_t offset, uint32_t object_size,
+                                        std::span<const uint8_t> data) {
+  if (!offset) {
+    av_packet_unref(object);
+    if (!object_size || object_size > kMaxMediaObjectSize ||
+        av_new_packet(object, int(object_size)) < 0)
+      return;
+    object_number = number;
+    object_filled = 0;
+  } else if (!object->data || number != object_number || offset != object_filled) {
+    av_packet_unref(object);
+    return;
+  }
+  if (data.size() > size_t(object->size) - object_filled) {
+    av_packet_unref(object);
+    return;
+  }
+  std::memcpy(object->data + object_filled, data.data(), data.size());
+  object_filled += data.size();
+  if (object_filled < size_t(object->size)) return;
+  AVPacket* complete = av_packet_alloc();
+  if (!complete) {
+    av_packet_unref(object);
+    return;
+  }
+  av_packet_move_ref(complete, object);
+  ready.push_back(complete);
+}
+
+// The next complete media object, owned by the caller; null at the end of the data or, with
+// error set, on a failure.
+AVPacket* WmaFileDecoder::State::NextObject() {
+  while (ready.empty()) {
+    if (!ReadPacket() || !ParsePacket()) return nullptr;
+  }
+  AVPacket* next = ready.front();
+  ready.pop_front();
+  return next;
+}
+
+bool WmaFileDecoder::State::AppendFrame(std::vector<float>& out) {
+  const size_t first = std::min(priming_frames, size_t(frame->nb_samples));
+  priming_frames -= first;
+  const size_t frames = size_t(frame->nb_samples) - first;
+  const size_t channels = size_t(channel_count);
+  const size_t base = out.size();
+  if (frame->format == AV_SAMPLE_FMT_FLTP) {
+    out.resize(base + frames * channels);
+    float* destination = out.data() + base;
+    for (size_t c = 0; c < channels; ++c) {
+      const auto* source = reinterpret_cast<const float*>(frame->extended_data[c]) + first;
+      for (size_t i = 0; i < frames; ++i) destination[i * channels + c] = source[i];
+    }
+  } else if (frame->format == AV_SAMPLE_FMT_FLT) {
+    const auto* source = reinterpret_cast<const float*>(frame->extended_data[0]) + first * channels;
+    out.insert(out.end(), source, source + frames * channels);
+  } else {
+    return Fail("unexpected decoder sample format");
+  }
+  av_frame_unref(frame);
+  return true;
+}
+
+WmaFileDecoder::WmaFileDecoder() : state_(std::make_unique<State>()) {}
+
+WmaFileDecoder::~WmaFileDecoder() = default;
+
+bool WmaFileDecoder::Open(const std::filesystem::path& path) {
+  state_ = std::make_unique<State>();
+  State& state = *state_;
+  state.file.open(path, std::ios::binary);
+  if (!state.file) return state.Fail("cannot open the file");
+  return state.ReadHeaders() && state.OpenCodec();
+}
+
+bool WmaFileDecoder::Decode(size_t samples, std::vector<float>& out) {
+  State& state = *state_;
+  if (!state.codec) return state.Fail("not open");
+  while (!state.ended && out.size() < samples) {
+    int result = avcodec_receive_frame(state.codec, state.frame);
+    if (result == 0) {
+      if (!state.AppendFrame(out)) return false;
+      continue;
+    }
+    if (result == AVERROR_EOF) {
+      state.ended = true;
+      break;
+    }
+    // A damaged block costs its samples, not the song.
+    if (result == AVERROR_INVALIDDATA) continue;
+    if (result != AVERROR(EAGAIN)) return state.Fail("decoding failed: " + AvErrorString(result));
+
+    // Null at the end of the data, which drains the decoder.
+    AVPacket* next = state.NextObject();
+    if (!state.error.empty()) return false;
+    if (!next && state.flushed) {
+      state.ended = true;
+      break;
+    }
+    result = avcodec_send_packet(state.codec, next);
+    state.flushed = !next;
+    av_packet_free(&next);
+    if (result < 0 && result != AVERROR_INVALIDDATA && result != AVERROR_EOF)
+      return state.Fail("decoding failed: " + AvErrorString(result));
+  }
+  return true;
+}
+
+int WmaFileDecoder::sample_rate() const { return state_->sample_rate; }
