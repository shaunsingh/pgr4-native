+// pgr4-native: the pad as user 0's reads saw it since the last rex_xam_take_frame_pad call,
+// which the native renderer makes at every guest Swap for its frame CSV. Buttons are OR'd over
+// the reads, the triggers kept at their highest and each stick axis at its largest deflection,
+// so a press shorter than a frame shows too. Bits 0-15 buttons, 16-23 LT, 24-31 RT, then LX,
+// LY, RX and RY (the axes' signed high bytes), 8 bits each.
+namespace {
+std::atomic<uint64_t> frame_pad{0};
+
+void NoteFramePad(const rex::input::X_INPUT_GAMEPAD& g) {
+  const int8_t axes[4] = {int8_t(int16_t(g.thumb_lx) >> 8), int8_t(int16_t(g.thumb_ly) >> 8),
+                          int8_t(int16_t(g.thumb_rx) >> 8), int8_t(int16_t(g.thumb_ry) >> 8)};
+  uint64_t old = frame_pad.load(std::memory_order_relaxed), next;
+  do {
+    next = (old | uint16_t(g.buttons)) & 0xFFFF;
+    next |= uint64_t(std::max(uint8_t(old >> 16), g.left_trigger)) << 16;
+    next |= uint64_t(std::max(uint8_t(old >> 24), g.right_trigger)) << 24;
+    for (int i = 0; i < 4; ++i) {
+      const int8_t was = int8_t(old >> (32 + 8 * i));
+      const int8_t now = std::abs(axes[i]) > std::abs(was) ? axes[i] : was;
+      next |= uint64_t(uint8_t(now)) << (32 + 8 * i);
+    }
+  } while (!frame_pad.compare_exchange_weak(old, next, std::memory_order_relaxed));
+}
+}  // namespace
