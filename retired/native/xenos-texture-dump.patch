     uint64_t now = rex::chrono::Clock::QueryHostUptimeMillis();
@@ -2214,6 +2288,88 @@
 
   command_processor_.ReleaseScratchGPUBuffer(copy_buffer, copy_buffer_state);
 
+  // pgr4-native: read the loaded host texture back and dump it with the guest bytes it came from.
+  if (!REXCVAR_GET(pgr4_dump_texture_loads).empty() && !texture_resolution_scaled && load_base &&
+      (load_mips || texture_key.mip_max_level == 0) &&
+      pgr4_texture_dumps_started < REXCVAR_GET(pgr4_dump_texture_loads_max) &&
+      pgr4_texture_dumped_keys
+          .insert(uint64_t(texture_key.base_page) | uint64_t(texture_key.format) << 20 |
+                  uint64_t(width) << 26 | uint64_t(height) << 42)
+          .second) {
+    ++pgr4_texture_dumps_started;
+    Pgr4TextureDump dump;
+    D3D12_RESOURCE_DESC resource_desc = texture_resource->GetDesc();
+    uint32_t sub_count = texture_level_count * array_size;
+    dump.layouts.resize(sub_count);
+    dump.rows.resize(sub_count);
+    dump.row_sizes.resize(sub_count);
+    UINT64 total = 0;
+    device->GetCopyableFootprints(&resource_desc, 0, sub_count, 0, dump.layouts.data(),
