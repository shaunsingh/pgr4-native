+    D3D12_RESOURCE_DESC buffer_desc;
+    ui::d3d12::util::FillBufferResourceDesc(buffer_desc, total, D3D12_RESOURCE_FLAG_NONE);
+    if (SUCCEEDED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE, &buffer_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&dump.buffer)))) {
+      command_processor_.PushTransitionBarrier(
+          texture_resource, d3d12_texture.SetResourceState(D3D12_RESOURCE_STATE_COPY_SOURCE),
+          D3D12_RESOURCE_STATE_COPY_SOURCE);
+      command_processor_.SubmitBarriers();
+      for (uint32_t i = 0; i < sub_count; ++i) {
+        D3D12_TEXTURE_COPY_LOCATION src = {}, dst = {};
+        src.pResource = texture_resource;
+        src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        src.SubresourceIndex = i;
+        dst.pResource = dump.buffer.Get();
+        dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        dst.PlacedFootprint = dump.layouts[i];
+        command_list.D3DCopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+      }
+      dump.submission = command_processor_.GetCurrentSubmission();
+      // The fetch constant this texture is bound with in the current draw.
+      xenos::xe_gpu_texture_fetch_t found_fetch = {};
+      uint32_t fetch_found = 0;
+      for (uint32_t i = 0; i < 32 && !fetch_found; ++i) {
+        xenos::xe_gpu_texture_fetch_t f = register_file().GetTextureFetch(i);
+        if (f.type == xenos::FetchConstantType::kTexture &&
+            (f.base_address & 0x1FFFF) == texture_key.base_page &&
+            GetBaseFormat(f.format) == texture_key.format &&
+            f.dimension == texture_key.dimension && f.size_2d.width + 1 == width) {
+          found_fetch = f;
+          fetch_found = 1;
+        }
+      }
+      uint32_t base_bytes = d3d12_texture.GetGuestBaseSize();
+      uint32_t mips_bytes = texture_key.mip_page ? d3d12_texture.GetGuestMipsSize() : 0;
+      dump.header = {0x44585450u, 1u, fetch_found, found_fetch.dword_0, found_fetch.dword_1,
+                     found_fetch.dword_2, found_fetch.dword_3, found_fetch.dword_4,
+                     found_fetch.dword_5, texture_key.base_page, texture_key.mip_page, width,
+                     height, depth_or_array_size, texture_key.pitch, texture_key.mip_max_level,
+                     uint32_t(texture_key.format), uint32_t(texture_key.endianness),
+                     uint32_t(texture_key.dimension), texture_key.tiled, texture_key.packed_mips,
+                     uint32_t(resource_desc.Format), uint32_t(load_shader), base_bytes, mips_bytes,
+                     sub_count};
+      dump.guest.resize(size_t(base_bytes) + mips_bytes);
+      auto* memory = rex::system::kernel_memory();
+      if (base_bytes) {
+        std::memcpy(dump.guest.data(),
+                    memory->TranslatePhysical<const uint8_t*>(texture_key.base_page << 12),
+                    base_bytes);
+      }
+      if (mips_bytes) {
+        std::memcpy(dump.guest.data() + base_bytes,
+                    memory->TranslatePhysical<const uint8_t*>(texture_key.mip_page << 12),
+                    mips_bytes);
+      }
+      char name[96];
+      std::snprintf(name, sizeof(name), "tex-%04d-%08X-fmt%u-%ux%u.ptxd",
+                    pgr4_texture_dumps_started, texture_key.base_page << 12,
+                    uint32_t(texture_key.format), width, height);
+      dump.name = name;
+      pgr4_texture_dumps.push_back(std::move(dump));
+    }
+  }
+
   return true;
