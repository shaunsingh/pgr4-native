                     "Maximum memory in MiB retained for reusable D3D12 texture resources")
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+// pgr4-native PGR4 native renderer oracle (native/xenos-texture-dump.patch):
+// dump the guest bytes and the loaded host data of textures loaded from guest memory.
+REXCVAR_DEFINE_STRING(pgr4_dump_texture_loads, "", "GPU",
+                      "pgr4-native: directory for texture load dumps (.ptxd); empty = off");
+REXCVAR_DEFINE_INT32(pgr4_dump_texture_loads_max, 400, "GPU",
+                     "pgr4-native: maximum number of texture loads to dump");
+
+namespace {
+// One texture load whose host data is being read back; written once its submission completed.
+struct Pgr4TextureDump {
+  Microsoft::WRL::ComPtr<ID3D12Resource> buffer;
+  uint64_t submission = 0;
+  std::vector<uint32_t> header;
+  std::vector<uint8_t> guest;  // base bytes then mip bytes, copied at load time
+  std::vector<D3D12_PLACED_SUBRESOURCE_FOOTPRINT> layouts;
+  std::vector<UINT> rows;
+  std::vector<UINT64> row_sizes;
+  std::string name;
+};
+std::vector<Pgr4TextureDump> pgr4_texture_dumps;
+int32_t pgr4_texture_dumps_started = 0;
+// Textures already dumped, by address, format and size: one dump each (FMV planes reload
+// every frame).
+std::unordered_set<uint64_t> pgr4_texture_dumped_keys;
+
+void Pgr4WriteTextureDumps(uint64_t completed_submission) {
+  for (size_t i = 0; i < pgr4_texture_dumps.size();) {
+    Pgr4TextureDump& d = pgr4_texture_dumps[i];
+    if (d.submission > completed_submission) {
+      ++i;
+      continue;
+    }
+    void* mapped = nullptr;
+    D3D12_RANGE range = {0, SIZE_T(d.buffer->GetDesc().Width)};
+    std::string path = REXCVAR_GET(pgr4_dump_texture_loads) + "/" + d.name;
+    FILE* f = nullptr;
+    if (SUCCEEDED(d.buffer->Map(0, &range, &mapped)) && (f = std::fopen(path.c_str(), "wb"))) {
+      std::fwrite(d.header.data(), 4, d.header.size(), f);
+      std::fwrite(d.guest.data(), 1, d.guest.size(), f);
+      for (size_t s = 0; s < d.layouts.size(); ++s) {
+        const D3D12_SUBRESOURCE_FOOTPRINT& fp = d.layouts[s].Footprint;
+        uint32_t sub[5] = {fp.Width, fp.Height, fp.Depth, d.rows[s], uint32_t(d.row_sizes[s])};
+        std::fwrite(sub, 4, 5, f);
+        for (uint32_t z = 0; z < fp.Depth; ++z) {
+          for (uint32_t y = 0; y < d.rows[s]; ++y) {
+            std::fwrite(static_cast<const uint8_t*>(mapped) + d.layouts[s].Offset +
+                            (uint64_t(z) * d.rows[s] + y) * fp.RowPitch,
+                        1, size_t(d.row_sizes[s]), f);
+          }
+        }
+      }
+      std::fclose(f);
+      REXGPU_INFO("pgr4 texture dump: {}", path);
+    } else {
+      REXGPU_ERROR("pgr4 texture dump: cannot write {}", path);
+    }
+    if (mapped) {
+      D3D12_RANGE none = {0, 0};
+      d.buffer->Unmap(0, &none);
+    }
+    pgr4_texture_dumps.erase(pgr4_texture_dumps.begin() + i);
+  }
+}
+}  // namespace
 
