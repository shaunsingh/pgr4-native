 namespace rex {
 
+namespace {
+
+// Installs the title's marketplace packages (DLC) found in content_root that are not installed
+// yet. A package counts as installed once its .header is written, the last step of
+// InstallContent, so an interrupted install is redone.
+void InstallContentPackages(system::KernelState& kernel_state,
+                            const std::filesystem::path& game_data_root) {
+  const std::string root_cvar = REXCVAR_GET(content_root);
+  const std::filesystem::path root =
+      root_cvar.empty() ? game_data_root / "Content" : std::filesystem::path(root_cvar);
+  std::error_code ec;
+  if (!std::filesystem::is_directory(root, ec)) {
+    return;
+  }
+  auto* content = kernel_state.content_manager();
+  const uint32_t title_id = kernel_state.title_id();
+  for (const auto& entry : std::filesystem::directory_iterator(root, ec)) {
+    if (!entry.is_regular_file(ec)) {
+      continue;
+    }
+    filesystem::StfsContainerDevice package("", entry.path());
+    if (!package.Initialize()) {
+      continue;
+    }
+    const auto& metadata = package.header().metadata;
+    if (metadata.content_type != system::XContentType::kMarketplaceContent ||
+        metadata.execution_info.title_id != title_id) {
+      continue;
+    }
+    const auto file_name = path_to_utf8(entry.path().filename());
+    system::xam::XCONTENT_AGGREGATE_DATA installed;
+    if (content->ReadContentHeaderFile(file_name, 0, title_id,
+                                       system::XContentType::kMarketplaceContent,
+                                       installed) == X_ERROR_SUCCESS) {
+      continue;
+    }
+    const auto result = content->InstallContent(entry.path());
+    if (result == X_ERROR_SUCCESS) {
+      REXLOG_INFO("Installed content package {} ({})", file_name,
+                  string::to_utf8(metadata.display_name(system::XLanguage::kEnglish)));
+    } else {
+      REXLOG_ERROR("Installing content package {} failed: {:08X}", entry.path().string(), result);
+    }
+  }
+}
+
