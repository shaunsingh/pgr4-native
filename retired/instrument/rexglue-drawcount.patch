+// ---------------------------------------------------------------------------
+// pgr4-native DrawCounter instrumentation (--gpu_stream_stats).
+// Counts what the PM4 command processor executes so a title's draw path can be
+// measured: draws by indirect-buffer depth, indirect buffers whose address,
+// size and contents recur across frames (prerecorded command buffers),
+// predicated packets and tile passes, resolves. Runs on the CP thread only.
+// Optional app side: if the executable exports
+//   extern "C" uint32_t rex_drawcount_api_counters(const uint64_t** values,
+//                                                 const char* const** names);
+// its cumulative counters (guest D3D draw-function calls) go on the same line.
+// ---------------------------------------------------------------------------
+namespace stream_stats {
+
+using ApiCountersFn = uint32_t (*)(const uint64_t** values, const char* const** names);
+constexpr uint32_t kMaxApi = 32;
+
+struct IbInfo {
+  uint64_t hash = 0;
+  uint64_t first_frame = 0;
+  uint64_t last_frame = 0;
+  uint32_t depth = 0;
+  uint64_t draws = 0;  // draws executed directly inside this buffer, lifetime
+};
+
+struct IbFrame {
+  bool reused;  // same address, size and hash seen in an earlier frame
+  bool repeat;  // same address, size and hash already executed this frame
+};
+
+struct Second {
+  uint64_t frames = 0;
+  uint64_t draws = 0;  // packets that reached IssueDraw and were not copies
+  uint64_t draws_depth[4] = {};
+  uint64_t resolves = 0;
+  uint64_t viz_killed = 0;
+  uint64_t draws_in_reused = 0;
+  uint64_t draws_in_repeat = 0;
+  uint64_t draws_predicated = 0;
+  uint64_t draws_predicate_skipped = 0;
+  uint64_t draws_later_tiles = 0;  // predicated draws not in the frame's first bin_select
+  uint64_t pred_exec = 0;
+  uint64_t pred_skip = 0;
+  uint64_t set_bin_select = 0;
+  uint64_t set_bin_mask = 0;
+  uint64_t event_write_ext = 0;
+  uint64_t viz_query = 0;
+  uint64_t im_load = 0;
+  uint64_t ib_exec = 0;
+  uint64_t ib_exec_depth2 = 0;
+  uint64_t ib_reused = 0;
+  uint64_t ib_repeat = 0;
+  uint64_t ib_words = 0;
+  uint64_t tiles_sum = 0;
+  uint64_t tiles_max = 0;
+  uint64_t frames_tiled = 0;
+  uint64_t draws_frame_max = 0;
+};
+
+struct State {
+  bool initialized = false;
+  bool enabled = false;
+  std::FILE* file = nullptr;
+  std::chrono::steady_clock::time_point start, last_emit;
+  ApiCountersFn api = nullptr;
+  uint64_t api_prev[kMaxApi] = {};
+  uint64_t frame = 0;
+  std::vector<IbFrame> stack;
+  uint32_t reused_depth = 0;
+  uint32_t repeat_depth = 0;
+  std::unordered_map<uint64_t, IbInfo> ibs;
+  std::vector<uint64_t> frame_selects;  // distinct bin_select_ of predicated draws this frame
+  uint64_t frame_draws = 0;
+  uint64_t ib_logged = 0;
+  Second sec;
+};
+
+State& Get() {
+  static State state;
+  return state;
+}
+
+bool Enabled() {
+  State& s = Get();
+  if (!s.initialized) {
+    s.initialized = true;
+    s.enabled = REXCVAR_GET(gpu_stream_stats);
+    if (s.enabled) {
+      const std::string path = REXCVAR_GET(gpu_stream_stats_file);
+      s.file = std::fopen(path.c_str(), "w");
+      if (!s.file) {
+        REXGPU_ERROR("gpu_stream_stats: cannot open {}", path);
+        s.enabled = false;
+        return false;
+      }
+#if REX_PLATFORM_WIN32
+      s.api = reinterpret_cast<ApiCountersFn>(
+          GetProcAddress(GetModuleHandleW(nullptr), "rex_drawcount_api_counters"));
+#endif
+      s.start = s.last_emit = std::chrono::steady_clock::now();
+      std::fprintf(s.file, "# gpu_stream_stats v1; api counters %s\n",
+                   s.api ? "found" : "not exported by the executable");
+      std::fflush(s.file);
+    }
+  }
+  return s.enabled;
+}
+
+void OnIndirectBufferBegin(const uint8_t* host, uint32_t ptr, uint32_t count, uint32_t depth) {
+  State& s = Get();
+  const uint64_t key = (uint64_t(ptr) << 32) | count;
+  const uint64_t hash = XXH3_64bits(host, size_t(count) * sizeof(uint32_t));
+  IbFrame f{false, false};
+  auto it = s.ibs.find(key);
+  if (it == s.ibs.end()) {
+    s.ibs.emplace(key, IbInfo{hash, s.frame, s.frame, depth, 0});
+  } else {
+    IbInfo& info = it->second;
+    if (info.hash == hash) {
+      if (info.last_frame == s.frame) {
+        f.repeat = true;
+      } else {
+        f.reused = true;
+      }
+    } else {
+      info.hash = hash;
+      info.first_frame = s.frame;
+    }
+    info.last_frame = s.frame;
+    info.depth = depth;
+  }
+  s.stack.push_back(f);
+  s.reused_depth += f.reused;
+  s.repeat_depth += f.repeat;
+  s.sec.ib_exec++;
+  s.sec.ib_words += count;
+  s.sec.ib_exec_depth2 += depth >= 2;
+  s.sec.ib_reused += f.reused;
+  s.sec.ib_repeat += f.repeat;
+  if (depth >= 2 && s.ib_logged < 64) {
+    ++s.ib_logged;
+    std::fprintf(s.file, "# frame %llu: depth-%u indirect buffer %08X, %u dwords, hash %016llX\n",
+                 (unsigned long long)s.frame, depth, ptr, count, (unsigned long long)hash);
+  }
+}
+
+void OnIndirectBufferEnd() {
+  State& s = Get();
+  if (s.stack.empty()) return;
+  s.reused_depth -= s.stack.back().reused;
+  s.repeat_depth -= s.stack.back().repeat;
+  s.stack.pop_back();
+}
+
+void OnPredicate(uint32_t opcode, bool executed) {
+  State& s = Get();
+  if (executed) {
+    s.sec.pred_exec++;
+  } else {
+    s.sec.pred_skip++;
+    if (opcode == PM4_DRAW_INDX || opcode == PM4_DRAW_INDX_2) s.sec.draws_predicate_skipped++;
+  }
+}
+
+void OnDraw(bool predicated, uint64_t bin_select, uint32_t depth, bool copy, bool viz_killed) {
+  State& s = Get();
+  if (viz_killed) {
+    s.sec.viz_killed++;
+    return;
+  }
+  if (copy) {
+    s.sec.resolves++;
+    return;
+  }
+  s.sec.draws++;
+  s.frame_draws++;
+  s.sec.draws_depth[std::min<uint32_t>(depth, 3)]++;
+  s.sec.draws_in_reused += s.reused_depth != 0;
+  s.sec.draws_in_repeat += s.repeat_depth != 0;
+  if (predicated) {
+    s.sec.draws_predicated++;
+    if (std::find(s.frame_selects.begin(), s.frame_selects.end(), bin_select) ==
+        s.frame_selects.end()) {
+      s.frame_selects.push_back(bin_select);
+    }
+    if (s.frame_selects.front() != bin_select) s.sec.draws_later_tiles++;
+  }
+}
+
+void Emit(State& s, std::chrono::steady_clock::time_point now) {
+  const Second& c = s.sec;
+  const double t = std::chrono::duration<double>(now - s.start).count();
+  const double fr = c.frames ? double(c.frames) : 1.0;
+  std::string line = fmt::format(
+      "t={:.1f} frames={} draws={} draws/f={:.1f} max/f={} d0={} d1={} d2={} d3+={} "
+      "in_reused_ib={} in_repeat_ib={} predicated={} pred_skipped_draws={} later_tile_draws={} "
+      "tiles/f={:.2f} tiles_max={} tiled_frames={} resolves={} resolves/f={:.1f} viz_killed={} "
+      "pred_exec={} pred_skip={} set_bin_select={} set_bin_mask={} event_write_ext={} "
+      "viz_query={} im_load={} ib={} ib_d2+={} ib_reused={} ib_repeat={} ib_dwords={} ib_keys={}",
+      t, c.frames, c.draws, c.draws / fr, c.draws_frame_max, c.draws_depth[0], c.draws_depth[1],
+      c.draws_depth[2], c.draws_depth[3], c.draws_in_reused, c.draws_in_repeat,
+      c.draws_predicated, c.draws_predicate_skipped, c.draws_later_tiles, c.tiles_sum / fr,
+      c.tiles_max, c.frames_tiled, c.resolves, c.resolves / fr, c.viz_killed, c.pred_exec,
+      c.pred_skip, c.set_bin_select, c.set_bin_mask, c.event_write_ext, c.viz_query, c.im_load,
+      c.ib_exec, c.ib_exec_depth2, c.ib_reused, c.ib_repeat, c.ib_words, s.ibs.size());
+  if (s.api) {
+    const uint64_t* values = nullptr;
+    const char* const* names = nullptr;
+    const uint32_t n = std::min(s.api(&values, &names), kMaxApi);
+    uint64_t total = 0;
+    std::string parts;
+    for (uint32_t i = 0; i < n; ++i) {
+      const uint64_t d = values[i] - s.api_prev[i];
+      s.api_prev[i] = values[i];
+      if (std::strncmp(names[i], "draw", 4) == 0) total += d;  // api_total: draw builders only
+      parts += fmt::format(" {}={}", names[i], d);
+    }
+    line += fmt::format(" | api_total={}{}", total, parts);
+  }
+  std::fprintf(s.file, "%s\n", line.c_str());
+  std::fflush(s.file);
+  s.sec = Second{};
+  // Forget buffers not seen for ~20 s so ring segments do not pile up.
+  for (auto it = s.ibs.begin(); it != s.ibs.end();) {
+    it = s.frame - it->second.last_frame > 600 ? s.ibs.erase(it) : std::next(it);
+  }
+}
+
+void OnSwap() {
+  State& s = Get();
+  s.sec.frames++;
+  const uint64_t tiles = s.frame_selects.size();
+  s.sec.tiles_sum += tiles;
+  s.sec.tiles_max = std::max(s.sec.tiles_max, tiles);
+  s.sec.frames_tiled += tiles > 1;
+  s.sec.draws_frame_max = std::max(s.sec.draws_frame_max, s.frame_draws);
+  s.frame_selects.clear();
+  s.frame_draws = 0;
+  s.frame++;
+  const auto now = std::chrono::steady_clock::now();
+  if (now - s.last_emit >= std::chrono::seconds(1)) {
+    s.last_emit = now;
+    Emit(s, now);
+  }
+}
+
+}  // namespace stream_stats
